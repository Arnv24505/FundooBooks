  padding: 0 10px;
  border: 1px solid rgba(255,255,255,.8);
  border-radius: 2px;
  color: #fff;
  font-size: 12px;
  white-space: nowrap;
}
.header-signup-link {
  background: #fff;
  color: var(--brand);
}
.header-login-link:hover,
.header-signup-link:hover { color: #fff; border-color: #fff; }
.header-signup-link:hover { background: rgba(255,255,255,.12); }
.category-nav {
  background: var(--surface);
  border-bottom: 1px solid var(--line);
  color: var(--text);
}
.category-nav-inner {
  display: flex;
  align-items: center;
  gap: 8px;
  min-height: 43px;
  overflow-x: auto;
  scrollbar-width: none;
}
.category-nav-link {
  flex: none;
  border: 1px solid transparent;
  border-radius: 18px;
  padding: 6px 13px;
  background: transparent;
  color: var(--text);
  font: inherit;
  font-size: 12px;
  cursor: pointer;
}
.category-nav-link:hover,
.category-nav-link.active {
  border-color: var(--brand);
  background: var(--brand);
  color: #fff;
}
.catalog-subtitle {
  margin: 3px 0 0;
  color: var(--text-soft);
  font-size: 11px;
}
.footer-inner {
  justify-content: space-between;
}
.footer-links {
  display: flex;
  gap: 18px;
  font-size: 11px;
  font-weight: 400;
}
.footer-links a:hover { text-decoration: underline; }

/* ---------- Breadcrumb ---------- */
.breadcrumb-bar {
  background: transparent;
  border: 0;
}

.breadcrumb-inner {
  padding: 16px 0 0;
  font-size: 12px;
  color: var(--muted);
  line-height: 16px;
}

.breadcrumb-inner a {
  color: var(--text-soft);
}

.breadcrumb-inner a:hover {
  color: var(--brand);
}

.breadcrumb-sep {
  margin: 0 4px;
  color: var(--text-soft);
}

.breadcrumb-inner .breadcrumb-current {
  color: var(--ink);
}

/* ---------- Catalog ---------- */
.catalog-hero {
  background: var(--canvas);
  border: 0;
}

.catalog-heading {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20px;
  padding: 20px 0 18px;
  flex-wrap: wrap;
}

.catalog-title {
  display: flex;
  align-items: baseline;
  gap: 12px;
  font-size: 25px;
  font-weight: 400;
  line-height: 33px;
  margin: 0;
  letter-spacing: 0;
  color: var(--ink);
}

.catalog-tools {
  display: flex;
  align-items: center;
  gap: 10px;
  padding-top: 6px;
}

.sort-select {
  width: 150px;
  min-width: 150px;
}

.sort-select .ant-select-selector {
  height: 30px !important;
  padding-inline: 0 !important;
  border: 0 !important;
  border-radius: 3px !important;
  background: transparent !important;
  box-shadow: none !important;
  font-size: 12px;
}

.sort-select .ant-select-selection-item {
  line-height: 30px !important;
  font-size: 12px;
  color: var(--text);
}

.sort-select .ant-select-arrow {
  inset-inline-end: 0;
  font-size: 10px;
  color: var(--ink);
}

.catalog-layout {
  display: block;
  padding: 0 0 40px;
}

.catalog-grid {
  display: grid;
  grid-template-columns: repeat(5, minmax(0, 1fr));
  gap: 16px;
}

.book-card {
  position: relative;
  display: flex;
  flex-direction: column;
  min-width: 0;
  background: var(--surface);
  border: 1px solid var(--line);
  border-radius: 3px;
  overflow: visible;
  height: 258px;
  transition: box-shadow 0.18s ease, border-color 0.18s ease;
}

.book-card:hover {
  border-color: #cfcfcf;
  box-shadow: 0 6px 18px var(--shadow-color);
}

.book-cover-wrap {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 158px;
  flex: none;
  margin: 1px 1px 0;
  background: var(--soft);
  border-radius: 2px 2px 0 0;
  overflow: hidden;
}

.book-cover {
  height: 132px;
  width: auto;
  max-width: 82%;
  object-fit: contain;
  border-radius: 1px;
  box-shadow: 0 6px 14px rgba(0, 0, 0, 0.18);
  background: var(--surface);
}

.cover-fallback {
  height: 135px;
  width: 100px;
  border-radius: 2px;
  background: linear-gradient(150deg, #a03037, #8f2b2f);
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 10px;
  text-align: center;
  font-size: 11px;
  line-height: 1.3;
  box-shadow: 0 6px 14px rgba(0, 0, 0, 0.18);
}

.out-of-stock-overlay {
  position: absolute;
  inset: 0;
  display: grid;
  place-items: center;
  background: rgba(245, 245, 245, 0.55);
  color: var(--brand);
  font-size: 15px;
  font-weight: 500;
  z-index: 2;
  pointer-events: none;
}

.quick-view {
  position: absolute;
  left: 50%;
  bottom: -12px;
  transform: translateX(-50%);
  z-index: 3;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: 24px;
  width: 76px;
  padding: 0 4px;
  border: 0;
  border-radius: 1px;
  background: rgba(0, 0, 0, 0.71);
  color: #fff;
  font-size: 11px;
  font-weight: 400;
  letter-spacing: 0.2px;
  text-transform: uppercase;
  cursor: pointer;
  opacity: 1;
}

.quick-view:hover {
  background: rgba(0, 0, 0, 0.85);
}

.book-card-body {
  display: flex;
  flex-direction: column;
  gap: 0;
  padding: 10px 10px 12px;
  min-width: 0;
  flex: 1;
}

.book-card-title {
  font-size: 12px;
  font-weight: 500;
  line-height: 16px;
  margin: 0;
  color: var(--ink);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.book-card-title:hover {
  color: var(--brand);
}

.book-card-author {
  font-size: 10px;
  line-height: 13px;
  color: var(--text-soft);
  margin: 3px 0 0;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.book-card-rating {
  display: flex;
  align-items: center;
  gap: 8px;
  margin-top: 7px;
  font-size: 10px;
  color: var(--text-soft);
  line-height: 13px;
  min-height: 16px;
}

.rating-badge {
  display: inline-flex;
  align-items: center;
  gap: 3px;
  height: 16px;
  padding: 0 4px;
  border-radius: 1px;
  background: #2e7d32;
  color: #fff;
  font-size: 10px;
  font-weight: 700;
  line-height: 16px;
}

.rating-badge .star {
  font-size: 8px;
  line-height: 1;
}

.price-row {
  display: flex;
  align-items: baseline;
  gap: 8px;
  margin-top: auto;
  padding-top: 8px;
  flex-wrap: wrap;
}

.price-now {
  font-size: 12px;
  font-weight: 700;
  line-height: 16px;
  color: var(--ink);
}

.price-was {
  font-size: 10px;
  line-height: 13px;
  color: var(--text-soft);
  text-decoration: line-through;
}

.price-off {
  display: none;
}

.empty-state {
  background: var(--surface);
  border: 1px solid var(--line);
  border-radius: 3px;
  padding: 56px 24px;
  text-align: center;
  color: var(--text-soft);
}

.load-more-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8px;
  padding: 28px 0 0;
  color: var(--muted);
  font-size: 12px;
}

/* ---------- Pagination ---------- */
.pagination {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 5px;
  padding: 40px 0 10px;
  flex-wrap: wrap;
}

.page-btn {
  min-width: 36px;
  height: 36px;
  padding: 0 4px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border: 1px solid var(--line);
  border-radius: 18px;
  background: var(--surface);
  color: var(--text);
  font-size: 10px;
  font-weight: 500;
  font-family: inherit;
  cursor: pointer;
  line-height: 1;
}

.page-btn:hover:not(:disabled) {
  border-color: var(--brand);
  color: var(--brand);
}

.page-btn.active {
  background: var(--brand-dark);
  border-color: var(--brand-dark);
  border-radius: 1px;
  color: #fff;
  font-size: 10px;
}

.page-btn:disabled {
  opacity: 0.45;
  cursor: default;
}

.page-btn.arrow,
.page-btn.prev,
.page-btn.next {
  font-size: 11px;
}

.page-btn.prev {
  border-radius: 1px;
  background: var(--soft);
}

.page-ellipsis {
  min-width: 20px;
  text-align: center;
  color: var(--text-faint);
  font-size: 10px;
  font-weight: 500;
}

/* ---------- Detail ---------- */
.detail-wrap {
  padding: 16px 0 52px;
}

.detail-grid {
  display: grid;
  grid-template-columns: 361px minmax(0, 1fr);
  gap: 50px;
  padding-left: 43px;
  align-items: start;
}

.detail-cover-panel {
  display: flex;
  flex-direction: column;
  margin: 0;
}

.detail-cover-frame {
  position: relative;
  width: 361px;
  height: 413px;
  border: 1px solid var(--line-strong);
  border-radius: 2px;
  background: var(--surface);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 24px;
}

.detail-cover {
  width: 282px;
  height: 364px;
  object-fit: contain;
  border-radius: 1px;
  background: var(--surface);
}

.cover-fallback.detail-cover {
  width: 282px;
  height: 364px;
  font-size: 18px;
  padding: 24px;
}

.detail-cover-frame .out-of-stock-overlay {
  background: rgba(255, 255, 255, 0.55);
  font-weight: 500;
}

.detail-buy-row {
  display: flex;
  gap: 21px;
  margin-top: 20px;
}

.detail-buy,
.detail-wish {
  width: 170px;
  height: 40px;
  border: 0;
  border-radius: 2px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  font-size: 15px;
  font-weight: 500;
  font-family: inherit;
  cursor: pointer;
  color: #fff;
  background: var(--brand);
}

.detail-buy:hover {
  background: var(--brand-dark);
}

.detail-buy:disabled {
  background: #c98f93;
  cursor: not-allowed;
}

.detail-wish {
  background: #333333;
}

.detail-wish:hover {
  background: #1f1f1f;
}

.detail-qty {
  display: inline-flex;
  align-items: center;
  justify-content: space-between;
  width: 170px;
  height: 40px;
  padding: 0 6px;
  border-radius: 2px;
  background: var(--brand);
  color: #fff;
}

.detail-qty button {
  width: 28px;
  height: 28px;
  border-radius: 50%;
  border: 1px solid rgba(255, 255, 255, 0.35);
  background: transparent;
  color: #fff;
  font-size: 16px;
  line-height: 1;
  cursor: pointer;
  font-family: inherit;
}

.detail-qty button:disabled {
  opacity: 0.4;
  cursor: not-allowed;
}

.detail-qty span {
  font-size: 15px;
  font-weight: 500;
}

.detail-main {
  min-width: 0;
  padding-top: 0;
}

.detail-title {
  font-size: 28px;
  font-weight: 400;
  line-height: 37px;
  margin: 0;
  color: var(--ink);
}

.detail-author {
  font-size: 18px;
  line-height: 24px;
  color: var(--text);
  margin: 6px 0 0;
}

.detail-rating {
  display: flex;
  align-items: center;
  gap: 9px;
  margin-top: 10px;
  min-height: 25px;
}

.detail-rating .rating-badge {
  height: 25px;
  min-width: 55px;
  padding: 0 6px;
  font-size: 14px;
  gap: 4px;
}

.detail-rating .rating-badge .star {
  font-size: 10px;
}

.detail-rating span.count {
  font-size: 15px;
  color: var(--text);
}

.detail-price {
  display: flex;
  align-items: baseline;
  gap: 18px;
  margin: 4px 0 0;
}

.detail-price .price-now {
  font-size: 30px;
  font-weight: 500;
  line-height: 39px;
}

.detail-price .price-was {
  font-size: 15px;
  line-height: 20px;
}

.detail-divider {
  height: 1px;
  background: #9d9d9d;
  opacity: 0.47;
  margin: 18px 0 0;
}

.detail-subhead {
  font-size: 15px;
  font-weight: 400;
  line-height: 20px;
  margin: 20px 0 0;
  color: var(--ink);
}

.detail-description {
  font-size: 12px;
  line-height: 18px;
  color: var(--text);
  margin: 8px 0 0;
  max-width: 551px;
  white-space: pre-line;
}

.detail-feedback {
  margin-top: 18px;
}

.feedback-title {
  font-size: 18px;
  font-weight: 400;
  line-height: 24px;
  margin: 0 0 16px;
  color: var(--ink);
}

.feedback-box {
  background: rgba(245, 245, 245, 0.63);
  border-radius: 2px;
  padding: 15px 17px 17px;
}

.feedback-label {
  font-size: 12px;
  line-height: 16px;
  color: var(--text);
}

.feedback-stars {
  display: flex;
  gap: 15px;
  margin: 10px 0 12px;
}

.feedback-stars .ant-rate {
  font-size: 20px;
  color: #ffce00;
}

.feedback-stars .ant-rate-star:not(:last-child) {
  margin-inline-end: 3px;
}

.feedback-textarea {
  background: var(--surface);
  border-radius: 3px;
  border: 1px solid var(--line);
  min-height: 63px;
}

.feedback-textarea textarea {
  font-size: 15px;
  padding: 10px 12px;
  resize: vertical;
}

.feedback-actions {
  display: flex;
  justify-content: flex-end;
  margin-top: 12px;
}

.feedback-submit {
  min-width: 76px;
  height: 24px;
  padding: 0 12px;
  border: 0;
  border-radius: 2px;
  background: var(--blue);
  color: #fff;
  font-size: 14px;
  font-family: inherit;
  cursor: pointer;
}

.feedback-submit:hover {
  background: #2a5f99;
}

.feedback-submit:disabled {
  opacity: 0.6;
  cursor: default;
}

.review-list {
  margin-top: 14px;
}

.review-row {
  display: flex;
  gap: 8px;
  padding: 14px 0;
  border-top: 0;
}

.review-row + .review-row {
  margin-top: 6px;
}

.review-avatar {
  width: 27px;
  height: 27px;
  border-radius: 50%;
  background: var(--soft);
  border: 1px solid var(--line);
  color: var(--text-faint);
  display: grid;
  place-items: center;
  font-size: 11px;
  flex: none;
}

.review-body {
  min-width: 0;
  flex: 1;
}

.review-meta {
  display: flex;
  align-items: center;
  gap: 10px;
  flex-wrap: wrap;
}

.review-meta strong {
  font-size: 15px;
  font-weight: 400;
  line-height: 20px;
}

.review-meta .ant-rate {
  font-size: 12px;
  color: #ffce00;
}

.review-date {
  color: var(--muted);
  font-size: 11px;
}

.review-comment {
  margin: 12px 0 0;
  color: var(--text);
  line-height: 20px;
  font-size: 12px;
}

.review-empty {
  color: var(--text-soft);
  font-size: 12px;
  margin: 16px 0 0;
}

/* Ordered layout for the detail page (left column sticks while scrolling). */
.detail-columns {
  display: grid;
  grid-template-columns: 361px minmax(0, 1fr);
  gap: 50px;
  padding-left: 43px;
  align-items: start;
}

/* ---------- Auth ---------- */
.auth-page {
  min-height: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40px 20px;
  position: relative;
  overflow: hidden;
  background: var(--surface);
}

/* The XD artboard places a full-bleed black rectangle at 31% opacity over the
   white page; the card sits above it. */
.auth-page::after {
  content: "";
  position: absolute;
  inset: 0;
  background: var(--overlay);
  pointer-events: none;
}

.auth-card {
  position: relative;
  z-index: 1;
  width: 727px;
  max-width: 100%;
  height: 425px;
}

.auth-illustration {
  position: absolute;
  left: 0;
  top: 19px;
  width: 624px;
  height: 391px;
  border-radius: 21px;
  background: var(--soft);
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: flex-start;
}

.auth-illustration svg {
  position: absolute;
  left: 53px;
  top: 52px;
  width: 245px;
  height: 245px;
}

.auth-illustration-copy {
  position: absolute;
  left: 28px;
  right: 28px;
  bottom: 30px;
  text-align: center;
  color: var(--ink);
}
.auth-illustration-copy h2 {
  margin: 0 0 8px;
  font-size: 20px;
  line-height: 26px;
  font-weight: 600;
}
.auth-illustration-copy p {
  max-width: 280px;
  margin: 0 auto;
  color: var(--text-soft);
  font-size: 12px;
  line-height: 18px;
}

.auth-form-panel {
  position: absolute;
  right: 0;
  top: 0;
  width: 389px;
  height: 425px;
  background: var(--surface);
  border: 1px solid var(--line);
  border-radius: 6px;
  box-shadow: 0 5px 7.5px var(--shadow-color);
  padding: 28px 68px 0;
  overflow-y: auto;
  scrollbar-width: none;
  -ms-overflow-style: none;
}

.auth-form-panel::-webkit-scrollbar {
  display: none;
}

.auth-tabs {
  display: flex;
  gap: 82px;
  margin: 0 0 25px;
}

.auth-tab {
  position: relative;
  font-size: 25px;
  font-weight: 500;
  line-height: 33px;
  color: var(--text-soft);
  padding: 0 0 5px;
}

.auth-tab.active {
  color: var(--ink);
}

.auth-tab.active::after {
  content: "";
  position: absolute;
  left: 50%;
  bottom: -2px;
  transform: translateX(-50%);
  width: 22px;
  height: 5px;
  border-radius: 4px;
  background: var(--brand);
}

.auth-title {
  font-size: 20px;
  font-weight: 500;
  line-height: 26px;
  margin: 0 0 6px;
  color: var(--ink);
}

.auth-subtitle {
  color: var(--text-soft);
  margin: 0 0 18px;
  font-size: 12px;
  line-height: 16px;
}

.auth-form-panel .ant-form-item {
  margin-bottom: 15px;
}

.auth-form-panel .ant-form-item-label {
  padding: 0 !important;
  height: 13px !important;
  min-height: 0 !important;
  line-height: 13px !important;
}

.auth-form-panel .ant-form-item-control {
  line-height: 1 !important;
}

.auth-form-panel .ant-form-item-control-input {
  min-height: 35px !important;
}

.auth-form-panel .ant-form-item-label > label {
  font-size: 10px !important;
  line-height: 13px !important;
  height: 13px !important;
  min-height: 0 !important;
  color: #333;
}

.auth-form-panel .ant-form-item-label > label::after {
  display: none;
}

.auth-form-panel .ant-input-affix-wrapper,
.auth-form-panel .ant-input,
.auth-form-panel .ant-input-password {
  height: 35px;
  min-height: 35px;
  border-radius: 2px;
  border-color: var(--line);
  font-size: 12px;
  padding-inline: 11px;
  box-shadow: none;
}

.auth-form-panel .ant-input-affix-wrapper {
  padding: 0 11px !important;
}

.auth-form-panel .ant-input-affix-wrapper .ant-input {
  height: 33px !important;
  min-height: 33px !important;
  line-height: 33px !important;
  padding: 0 !important;
}

.auth-form-panel .ant-input-affix-wrapper-focused,
.auth-form-panel .ant-input-affix-wrapper:focus-within {
  border-color: var(--brand);
  box-shadow: none;
}

.auth-form-panel .anticon {
  font-size: 13px;
  color: var(--muted);
}

.auth-form-panel .ant-btn-primary {
  height: 37px;
  border-radius: 3px;
  background: var(--brand);
  font-size: 15px;
  font-weight: 400;
  box-shadow: none;
}

.auth-form-panel .ant-btn-primary:hover {
  background: var(--brand-dark) !important;
}

.auth-form-panel .ant-form-item-explain-error {
  font-size: 10px;
  padding-top: 2px;
}

.auth-divider {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16px;
  color: var(--ink);
  font-size: 14px;
  font-weight: 700;
  line-height: 18px;
  margin: 26px 0 28px;
}

.auth-divider::before,
.auth-divider::after {
  content: "";
  flex: 1;
  height: 1px;
  background: #e1e4ea;
}

.social-row {
  display: flex;
  gap: 7px;
}

.social-btn {
  height: 37px !important;
  border-radius: 3px;
  font-size: 12px;
  font-weight: 400;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  font-family: inherit;
  cursor: pointer;
}

.social-btn.facebook {
  flex: 0 0 126px;
  border: 0;
  background: #4266b2;
  color: #fff;
}

.social-btn.facebook:hover {
  background: #3a5a9e !important;
  color: #fff !important;
}

.social-btn.google {
  flex: 1;
  background: var(--soft);
  border: 1px solid var(--line);
  color: var(--ink);
}

.social-btn.google:hover {
  background: #fff !important;
  border-color: var(--brand) !important;
  color: var(--brand) !important;
}

.google-g {
  font-weight: 700;
  color: #4285f4;
  font-size: 14px;
}

.fb-blue {
  font-weight: 700;
  color: #fff;
  font-size: 14px;
}

.auth-forgot {
  text-align: right;
  margin: -12px 0 14px;
  font-size: 10px;
  line-height: 13px;
  color: var(--muted);
}

.auth-forgot a {
  color: var(--muted);
}

.auth-forgot a:hover {
  color: var(--brand);
}

.auth-footnote {
  margin-top: 14px;
  text-align: center;
  color: var(--text-soft);
  font-size: 12px;
}

.auth-footnote a {
  color: var(--brand);
}

.auth-submit {
  margin-top: 6px;
}

.auth-legal {
  text-align: center;
  font-size: 10px;
  color: var(--muted);
  margin: 6px 0 0;
}

/* ---------- Checkout / cart ---------- */
.page-head {
  padding: 22px 0 6px;
}

.page-title {
  font-size: 22px;
  margin: 0;
  letter-spacing: 0;
  font-weight: 500;
}

.steps {
  display: flex;
  gap: 10px;
  align-items: center;
  flex-wrap: wrap;
  margin: 18px 0 22px;
  font-size: 12px;
  color: var(--text-soft);
}

.step {
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 7px 12px;
  border-radius: 3px;
  background: var(--surface);
  border: 1px solid var(--line);
}

.step.active {
  color: var(--brand);
  border-color: #e0b4b8;
  background: var(--brand-soft);
  font-weight: 500;
}

.step.done {
  color: var(--success);
  border-color: #bfe3c8;
  background: #f1fbf4;
}

.step-index {
  width: 20px;
  height: 20px;
  border-radius: 50%;
  background: #eee;
  display: grid;
  place-items: center;
  font-size: 10px;
}

.step.active .step-index {
  background: var(--brand);
  color: #fff;
}

.step.done .step-index {
  background: var(--success);
  color: #fff;
}

.checkout-grid {
  display: grid;
  grid-template-columns: minmax(0, 1fr) 340px;
  gap: 24px;
  align-items: start;
  padding-bottom: 48px;
}

.panel {
  background: var(--surface);
  border: 1px solid var(--line);
  border-radius: 3px;
  padding: 20px;
}

.panel + .panel {
  margin-top: 16px;
}

.panel-title {
  font-size: 16px;
  font-weight: 500;
  margin: 0 0 14px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10px;
}

.cart-line {
  display: grid;
  grid-template-columns: 68px minmax(0, 1fr) auto;
  gap: 14px;
  padding: 16px 0;
  border-top: 1px solid var(--line);
  align-items: center;
}

.cart-line:first-of-type {
  border-top: 0;
  padding-top: 0;
}

.cart-thumb {
  width: 68px;
  height: 96px;
  object-fit: contain;
  border-radius: 2px;
  background: var(--soft);
}

.cart-line-title {
  font-weight: 500;
  font-size: 14px;
  margin: 0 0 3px;
}

.cart-line-meta {
  color: var(--text-soft);
  font-size: 12px;
  margin: 0;
}

.cart-line-actions {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 10px;
}

.summary-row {
  display: flex;
  justify-content: space-between;
  gap: 12px;
  padding: 7px 0;
  font-size: 13px;
  color: var(--text-faint);
}

.summary-row.total {
  border-top: 1px solid var(--line);
  margin-top: 8px;
  padding-top: 14px;
  font-size: 16px;
  font-weight: 700;
  color: var(--ink);
}

.summary-free {
  color: var(--success);
  font-size: 11px;
  font-weight: 500;
  margin-top: 8px;
}

.address-card {
  border: 1px solid var(--line);
  border-radius: 3px;
  padding: 16px;
  cursor: pointer;
  height: 100%;
  background: var(--surface);
  transition: border-color 0.15s ease, background 0.15s ease;
}

.address-card.selected {
  border-color: var(--brand);
  background: #fffafb;
  box-shadow: 0 0 0 1px var(--brand);
}

.address-label {
  font-size: 10px;
  font-weight: 700;
  letter-spacing: 1px;
  text-transform: uppercase;
  color: var(--brand);
}

.address-text {
  color: var(--text-faint);
  font-size: 12px;
  line-height: 1.6;
  margin: 6px 0 0;
}

.address-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12px;
}

/* ---------- Orders ---------- */
.order-list {
  display: grid;
  gap: 22px;
  padding-bottom: 36px;
}

.order-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 24px;
  background: var(--surface);
  border: 1px solid var(--line);
  padding: 33px 39px 33px 36px;
  min-height: 151px;
}

.order-info {
  display: flex;
  gap: 38px;
  min-width: 0;
  flex: 1;
}

.order-cover {
  width: 65px;
  height: 85px;
  object-fit: contain;
  background: var(--soft);
  flex: none;
}

.order-info-body {
  min-width: 0;
}

.order-book-title {
  display: block;
  font-size: 18px;
  font-weight: 400;
  line-height: 24px;
  color: var(--ink);
}

.order-book-title:hover {
  color: var(--brand);
}

.order-book-author {
  font-size: 12px;
  line-height: 16px;
  color: var(--text-soft);
  margin: 4px 0 8px;
}

.order-price {
  display: flex;
  align-items: baseline;
  gap: 12px;
}

.order-price .price-now {
  font-size: 15px;
  line-height: 20px;
  font-weight: 700;
}

.order-price .price-was {
  font-size: 12px;
  line-height: 16px;
}

.order-placed {
  display: flex;
  align-items: center;
  gap: 8px;
  font-size: 15px;
  font-weight: 700;
  line-height: 20px;
  color: var(--ink);
  white-space: nowrap;
  text-align: right;
}

.order-dot {
  width: 7px;
  height: 7px;
  border-radius: 50%;
  background: #388e3c;
  flex: none;
}

.order-meta-note {
  font-size: 11px;
  font-weight: 400;
  color: var(--text-soft);
  margin-top: 6px;
  text-align: right;
}

.order-card {
  background: var(--surface);
  border: 1px solid var(--line);
  border-radius: 3px;
  padding: 20px;
}

.order-card + .order-card {
  margin-top: 16px;
}

.order-head {
  display: flex;
  justify-content: space-between;
  gap: 14px;
  flex-wrap: wrap;
  align-items: flex-start;
  border-bottom: 1px solid var(--line);
  padding-bottom: 12px;
  margin-bottom: 14px;
}

.order-thumbs {
  display: flex;
  gap: 10px;
  flex-wrap: wrap;
}

.order-thumb {
  width: 52px;
  height: 74px;
  object-fit: contain;
  border-radius: 2px;
  background: var(--soft);
}

.success-wrap {
  max-width: 760px;
  margin: 40px auto 56px;
  background: var(--surface);
  border: 1px solid var(--line);
  border-radius: 3px;
  padding: 40px;
  text-align: center;
}

.success-mark {
  width: 74px;
  height: 74px;
  border-radius: 50%;
  background: #f1fbf4;
  color: var(--success);
  display: grid;
  place-items: center;
  font-size: 38px;
  margin: 0 auto 18px;
}

.success-title {
  font-size: 24px;
  margin: 0 0 8px;
  letter-spacing: 0;
}

.success-sub {
  color: var(--text-soft);
  margin: 0 0 6px;
}

.contact-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16px;
  text-align: left;
  margin-top: 30px;
  border-top: 1px solid var(--line);
  padding-top: 26px;
}

.contact-card {
  background: var(--soft);
  border-radius: 3px;
  padding: 16px;
  font-size: 12px;
  line-height: 1.6;
  color: var(--text-faint);
}

.contact-card h4 {
  margin: 0 0 6px;
  font-size: 11px;
  text-transform: uppercase;
  letter-spacing: 1px;
  color: var(--ink);
}

/* ---------- Wishlist ---------- */
.account-page {
  padding: 16px 0 40px;
}

.account-shell {
  border: 1px solid var(--line);
  background: var(--surface);
}

.account-head {
  height: 55px;
  background: var(--soft);
  border-bottom: 1px solid #e4e4e4;
  padding: 0 36px;
  display: flex;
  align-items: center;
}

.account-title {
  font-size: 18px;
  font-weight: 500;
  line-height: 24px;
  margin: 0;
  color: var(--ink);
}

.wl-row {
  display: flex;
  align-items: flex-start;
  gap: 38px;
  padding: 33px 36px;
  border-bottom: 1px solid #e4e4e4;
  min-height: 178px;
}

.wl-row:last-child {
  border-bottom: 0;
}

.wl-cover {
  width: 65px;
  height: 85px;
  object-fit: contain;
  background: var(--soft);
  flex: none;
}

.wl-body {
  flex: 1;
  min-width: 0;
}

.wl-title {
  display: block;
  font-size: 18px;
  font-weight: 400;
  line-height: 24px;
  color: var(--ink);
}

.wl-title:hover {
  color: var(--brand);
}

.wl-author {
  font-size: 12px;
  line-height: 16px;
  color: var(--text-soft);
  margin: 4px 0 8px;
}

.wl-actions {
  display: flex;
  align-items: center;
  gap: 16px;
  flex: none;
}

.wl-add {
  height: 32px;
  padding: 0 16px;
  border: 1px solid var(--brand);
  border-radius: 2px;
  background: var(--surface);
  color: var(--brand);
  font-size: 12px;
  font-family: inherit;
  cursor: pointer;
}

.wl-add:hover {
  background: var(--brand);
  color: #fff;
}

.wl-remove {
  width: 30px;
  height: 30px;
  border: 0;
  background: transparent;
  color: var(--muted);
  cursor: pointer;
  font-size: 15px;
  display: grid;
  place-items: center;
}

.wl-remove:hover {
  color: var(--brand);
}

.wl-empty {
  padding: 60px 24px;
  text-align: center;
  color: var(--text-soft);
}

/* ---------- Profile ---------- */
.profile-page {
  padding: 16px 0 40px;
}

.profile-wrap {
  padding-left: 40px;
  padding-right: 40px;
}

.profile-section {
  margin-bottom: 40px;
}

.profile-section-head {
  display: flex;
  align-items: center;
  gap: 20px;
  margin-bottom: 22px;
}

.profile-section-head h2 {
  font-size: 18px;
  font-weight: 500;
  line-height: 24px;
  margin: 0;
  color: var(--ink);
}

.profile-edit-link {
  border: 0;
  background: none;
  padding: 0;
  font-size: 12px;
  font-weight: 500;
  color: var(--brand);
  cursor: pointer;
  font-family: inherit;
}

.profile-save {
  height: 34px;
  min-width: 123px;
  border: 0;
  border-radius: 3px;
  background: var(--blue);
  color: #fff;
  font-size: 12px;
  font-family: inherit;
  cursor: pointer;
}

.profile-save:hover {
  background: #2a5f99;
}

/* XD uses blue #3371b5 for checkout/confirmation actions. */
.btn-xd-blue.ant-btn {
  background: var(--blue);
  border-color: var(--blue);
  color: #fff;
  box-shadow: none;
}

.btn-xd-blue.ant-btn:not(:disabled):hover {
  background: #2a5f99;
  border-color: #2a5f99;
  color: #fff;
}

.profile-fields {
  display: grid;
  gap: 31px;
  max-width: 512px;
}

.profile-field {
  min-width: 0;
}

.profile-field-label {
  display: block;
  font-size: 12px;
  line-height: 16px;
  color: var(--text);
  margin-bottom: 6px;
}

.profile-field-value {
  height: 45px;
  border: 1px solid var(--line);
  border-radius: 2px;
  background: var(--soft);
  padding: 12px 16px;
  font-size: 15px;
  line-height: 20px;
  color: var(--text);
  display: flex;
  align-items: center;
}

.profile-field-input {
  height: 45px;
  border-radius: 2px;
  font-size: 15px;
}

.profile-address-list {
  display: grid;
  gap: 22px;
  max-width: 512px;
}

.profile-address {
  border: 1px solid var(--line-strong);
  border-radius: 2px;
  background: var(--surface);
  padding: 0 0 18px;
}

.profile-address-head {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 14px 16px 12px;
}

.profile-address-head h3 {
  font-size: 15px;
  font-weight: 500;
  margin: 0;
  text-transform: uppercase;
}

.profile-address-lines {
  padding: 6px 16px 0;
  font-size: 12px;
  line-height: 22px;
  color: var(--text);
}

.profile-address-actions {
  display: flex;
  align-items: center;
  gap: 14px;
  padding: 12px 16px 0;
}

.link-button {
  border: 0;
  background: none;
  padding: 0;
  font-size: 12px;
  color: var(--brand);
  cursor: pointer;
  font-family: inherit;
}

.link-button.muted {
  color: var(--text-soft);
}

.link-button:hover {
  text-decoration: underline;
}

.profile-add-address {
  height: 29px;
  padding: 0 14px;
  border: 1px solid var(--brand);
  border-radius: 2px;
  background: var(--surface);
  color: var(--brand);
  font-size: 12px;
  font-family: inherit;
  cursor: pointer;
}

.profile-add-address:hover {
  background: var(--brand);
  color: #fff;
}

.profile-grid {
  display: block;
  padding-bottom: 40px;
}

.detail-list {
  display: grid;
  gap: 14px;
}

.detail-list .label {
  color: var(--text-soft);
  font-size: 11px;
  text-transform: uppercase;
  letter-spacing: 0.8px;
}

.detail-list .value {
  font-size: 15px;
  font-weight: 500;
  margin-top: 2px;
}

/* ---------- Storefront addenda (XD parity) ---------- */
.container-account {
  width: 100%;
  max-width: 1022px;
  margin: 0 auto;
  padding: 0;
}

.catalog-page {
  padding-top: 2px;
}

/* Book card price/rating rows used by the rebuilt card + skeletons. */
.book-card-price {
  display: flex;
  align-items: baseline;
  gap: 8px;
  margin-top: auto;
  padding-top: 7px;
  flex-wrap: wrap;
}

.book-card-skeleton {
  height: 275px;
  padding: 10px;
  gap: 12px;
  border: 1px solid var(--line);
  border-radius: 3px;
  background: var(--surface);
}

.book-card-skeleton .ant-skeleton {
  padding: 0 10px;
}

.skeleton-cover {
  display: block;
  width: 100%;
  height: 172px;
  border-radius: 2px;
  background: linear-gradient(90deg, #f2f2f2 25%, #e9e9e9 37%, #f2f2f2 63%);
  background-size: 400% 100%;
  animation: skeleton-sheen 1.3s ease infinite;
}

.skeleton-line {
  display: block;
  height: 12px;
  width: 82%;
  margin: 12px 10px 0;
  border-radius: 2px;
  background: #efefef;
}

.skeleton-line.short {
  width: 48%;
}

.skeleton-sort {
  display: inline-block;
  width: 150px;
  height: 30px;
  border-radius: 3px;
  background: #f2f2f2;
}

@keyframes skeleton-sheen {
  0% {
    background-position: 100% 50%;
  }
  100% {
    background-position: 0 50%;
  }
}

/* Detail page feedback form */
.detail-bullet {
  display: inline-block;
  width: 5px;
  height: 5px;
  border-radius: 50%;
  background: var(--ink);
  margin-right: 8px;
  vertical-align: middle;
}

.feedback-form {
  margin-top: 4px;
}

.feedback-form .ant-form-item {
  margin-bottom: 10px;
}

.feedback-rating-item {
  margin-bottom: 8px !important;
}

.feedback-rating-item .ant-rate {
  font-size: 22px;
  color: #ffce00;
}

.feedback-comment-item {
  margin-bottom: 4px !important;
}

.feedback-signin {
  margin: 10px 0 0;
  font-size: 12px;
  color: var(--text-soft);
}

.feedback-signin a {
  color: var(--blue);
}

.review-stars {
  font-size: 12px !important;
  color: #ffce00 !important;
  margin: 2px 0 0;
}

/* Orders status column */
.order-status-col {
  flex: none;
  display: flex;
  align-items: flex-start;
  justify-content: flex-end;
  padding-top: 4px;
  min-width: 190px;
}

.order-placed.delivered .order-dot {
  background: #388e3c;
}

.order-placed.cancelled .order-dot {
  background: #ff4e61;
}

.order-placed.shipped .order-dot {
  background: #3371b5;
}

.order-placed.confirmed .order-dot {
  background: #ffaa00;
}

/* Wishlist list */
.wl-list {
  display: block;
}

.wl-cover-link {
  flex: none;
  display: block;
}

.wl-price {
  display: flex;
  align-items: baseline;
  gap: 14px;
}

.wl-price .price-now {
  font-size: 15px;
  line-height: 20px;
}

.wl-price .price-was {
  font-size: 12px;
  line-height: 16px;
}

/* Account loading / empty states */
.account-loading {
  padding: 32px 36px;
}

.account-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 10px;
  padding: 70px 24px 76px;
  text-align: center;
  color: var(--text-soft);
}

.account-empty h2 {
  font-size: 18px;
  font-weight: 500;
  margin: 0;
  color: var(--ink);
}

.account-empty p {
  margin: 0;
  font-size: 13px;
  max-width: 380px;
}

.account-empty-mark {
  width: 64px;
  height: 64px;
  border-radius: 50%;
  display: grid;
  place-items: center;
  background: var(--brand-soft);
  color: var(--brand);
  font-size: 26px;
  margin-bottom: 4px;
}

/* Profile inline editing */
.profile-form {
  display: block;
}

.profile-link {
  border: 0;
  background: none;
  padding: 0;
  font-family: inherit;
  font-size: 12px;
  font-weight: 500;
  color: var(--brand);
  cursor: pointer;
}

.profile-link:hover {
  text-decoration: underline;
}

.profile-add-link {
  border: 0;
  background: none;
  padding: 0;
  font-family: inherit;
  font-size: 12px;
  font-weight: 500;
  color: var(--blue);
  cursor: pointer;
}

.profile-add-link:hover {
  text-decoration: underline;
}

.profile-password-field {
  display: flex;
  align-items: center;
  gap: 16px;
