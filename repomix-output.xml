import { connectDB } from "@/lib/db";
import { User } from "@/models/User";
import mongoose from "mongoose";

/**
 * Promote an existing account to admin.
 * Usage: npm run make:admin -- you@example.com
 */
async function main() {
  const email = process.argv[2]?.trim().toLowerCase();
  if (!email) {
    console.error("Usage: npm run make:admin -- you@example.com");
    process.exitCode = 1;
    return;
  }

  await connectDB();
  const user = await User.findOneAndUpdate(
    { email },
    { $set: { role: "admin" } },
    { returnDocument: "after" }
  ).lean();

  if (!user) {
    console.error(`No account found for ${email}`);
    process.exitCode = 1;
    return;
  }
  console.log(`${user.email} is now an admin.`);
}

main()
  .catch((error) => {
    console.error("make-admin failed:", error instanceof Error ? error.message : error);
    process.exitCode = 1;
  })
  .finally(() => mongoose.disconnect());
</file>

<file path="src/scripts/refreshStorefrontFields.ts">
import { connectDB } from "@/lib/db";
import {
  demoOriginalPriceFor,
  demoPriceFor,
  demoRatingFor,
  demoStockFor,
} from "@/lib/money";
import { Book } from "@/models/Book";
import mongoose from "mongoose";

/**
 * Refresh storefront-only fields (price, stock, rating) on already-imported
 * books. Gutendex is never contacted. Useful after changing pricing rules.
 */
async function main() {
  await connectDB();
  const books = await Book.find({}, { sourceId: 1, price: 1 }).lean();
  const operations = books
    .filter((book) => typeof book.sourceId === "number")
    .map((book) => {
      const id = book.sourceId as number;
      const price = demoPriceFor(id);
      return {
        updateOne: {
          filter: { _id: book._id },
          update: {
            $set: {
              price,
              originalPrice: demoOriginalPriceFor(price),
              stock: demoStockFor(id),
              rating: demoRatingFor(id),
            },
          },
        },
      };
    });

  if (operations.length > 0) {
    const result = await Book.bulkWrite(operations, { ordered: false });
    console.log(`Updated storefront fields on ${result.modifiedCount} books`);
  } else {
    console.log("No books found");
  }
}

main()
  .catch((error) => {
    console.error("refresh failed:", error instanceof Error ? error.message : error);
    process.exitCode = 1;
  })
  .finally(() => mongoose.disconnect());
</file>

<file path="src/services/addressService.ts">
import { isValidObjectId } from "mongoose";
import { connectDB } from "@/lib/db";
import { ApiError } from "@/lib/apiError";
import { Address } from "@/models/Address";

export async function listAddresses(userId: string) {
  await connectDB();
  return Address.find({ userId }).sort({ isDefault: -1, createdAt: -1 }).lean();
}

export async function createAddress(userId: string, input: Record<string, unknown>) {
  await connectDB();
  const count = await Address.countDocuments({ userId });
  const makeDefault = input.isDefault === true || count === 0;

  if (makeDefault) {
    await Address.updateMany({ userId }, { $set: { isDefault: false } });
  }

  const address = await Address.create({ ...input, userId, isDefault: makeDefault });
  return address.toObject();
}

export async function updateAddress(
  userId: string,
  addressId: string,
  input: Record<string, unknown>
) {
  if (!isValidObjectId(addressId)) throw new ApiError(400, "Invalid address id");
  await connectDB();
  const address = await Address.findOne({ _id: addressId, userId });
  if (!address) throw new ApiError(404, "Address not found");

  if (input.isDefault === true) {
    await Address.updateMany({ userId, _id: { $ne: address._id } }, { $set: { isDefault: false } });
  }

  Object.assign(address, input);
  await address.save();
  return address.toObject();
}

export async function deleteAddress(userId: string, addressId: string) {
  if (!isValidObjectId(addressId)) throw new ApiError(400, "Invalid address id");
  await connectDB();
  const address = await Address.findOneAndDelete({ _id: addressId, userId });
  if (!address) throw new ApiError(404, "Address not found");

  if (address.isDefault) {
    const next = await Address.findOne({ userId }).sort({ createdAt: -1 });
    if (next) {
      next.isDefault = true;
      await next.save();
    }
  }
  return { deleted: true };
}

export async function getAddressForUser(userId: string, addressId: string) {
  if (!isValidObjectId(addressId)) throw new ApiError(400, "Invalid address id");
  await connectDB();
  const address = await Address.findOne({ _id: addressId, userId }).lean();
  if (!address) throw new ApiError(404, "Address not found");
  return address;
}
</file>

<file path="src/services/adminBookService.ts">
import { isValidObjectId } from "mongoose";
import { connectDB } from "@/lib/db";
import { env } from "@/lib/env";
import { ApiError } from "@/lib/apiError";
import { Book } from "@/models/Book";
import { Cart } from "@/models/Cart";
import { Review } from "@/models/Review";
import { StockAlert } from "@/models/StockAlert";
import { Wishlist } from "@/models/Wishlist";
import { notifyStockAlerts } from "@/services/stockAlertService";
import type { AdminBookInput } from "@/validators/adminBook";

export async function listAdminBooks(options: {
  page: number;
  limit: number;
  search?: string;
  lowStock?: boolean;
}) {
  await connectDB();
  const filter: Record<string, unknown> = {};
  if (options.search) {
    const pattern = new RegExp(options.search.replace(/[.*+?^${}()|[\]\\]/g, "\\$&"), "i");
    filter.$or = [{ title: pattern }, { "authors.name": pattern }, { isbn: pattern }];
  }
  if (options.lowStock) filter.stock = { $lte: 3 };

  const [data, total] = await Promise.all([
    Book.find(filter)
      .select(
        "title authors coverImage price originalPrice stock rating reviewCount isbn publisher binding sourceId isDemoData createdAt"
      )
      .sort({ createdAt: -1 })
      .skip((options.page - 1) * options.limit)
      .limit(options.limit)
      .lean(),
    Book.countDocuments(filter),
  ]);

  return {
    data,
    pagination: {
      page: options.page,
      limit: options.limit,
      total,
      totalPages: Math.ceil(total / options.limit),
    },
  };
}

export async function createBook(input: AdminBookInput) {
  await connectDB();
  const book = await Book.create({
    ...input,
    sourceId: -Math.floor(Date.now() / 1000) - Math.floor(Math.random() * 1000),
    authors: input.authors.map((author) => ({ name: author.name })),
    originalPrice: input.originalPrice || undefined,
    coverImage: input.coverImage || undefined,
    description: input.description || undefined,
    isDemoData: true,
    rating: 0,
    reviewCount: 0,
  });
  return book.toObject();
}

export async function updateBook(bookId: string, input: Partial<AdminBookInput> & { rating?: number }) {
  if (!isValidObjectId(bookId)) throw new ApiError(400, "Invalid book id");
  await connectDB();
  const book = await Book.findById(bookId);
  if (!book) throw new ApiError(404, "Book not found");

  const wasOutOfStock = (book.stock ?? 0) <= 0;
  Object.assign(book, input);
  await book.save();

  if (wasOutOfStock && (book.stock ?? 0) > 0) {
    await notifyStockAlerts(String(book._id), book.title, env.appUrl);
  }

  return book.toObject();
}

export async function deleteBook(bookId: string) {
  if (!isValidObjectId(bookId)) throw new ApiError(400, "Invalid book id");
  await connectDB();
  const book = await Book.findByIdAndDelete(bookId);
  if (!book) throw new ApiError(404, "Book not found");

  await Promise.all([
    Cart.updateMany({}, { $pull: { items: { bookId: book._id } } }),
    Wishlist.updateMany({}, { $pull: { bookIds: book._id } }),
    Review.deleteMany({ bookId: book._id }),
    StockAlert.deleteMany({ bookId: book._id }),
  ]);

  return { deleted: true };
}
</file>

<file path="src/services/authService.ts">
import { createHash, randomBytes } from "node:crypto";
import { connectDB } from "@/lib/db";
import { ApiError } from "@/lib/apiError";
import { env } from "@/lib/env";
import { hashPassword, verifyPassword } from "@/lib/auth";
import { queueEmail } from "@/lib/mailer";
import { User, toSafeUser, type SafeUser } from "@/models/User";
import { PasswordResetToken } from "@/models/PasswordResetToken";
import type { LoginInput, RegisterInput, UpdateProfileInput } from "@/validators/auth";

function hashToken(token: string): string {
  return createHash("sha256").update(token).digest("hex");
}

function normaliseEmail(email: string): string {
  return email.trim().toLowerCase();
}

export async function registerUser(input: RegisterInput): Promise<{ user: SafeUser; tokenVersion: number }> {
  await connectDB();
  const email = normaliseEmail(input.email);
  const existing = await User.exists({ email });
  if (existing) throw new ApiError(409, "An account with this email already exists");

  const passwordHash = await hashPassword(input.password);
  const isAdmin = env.adminEmails.includes(email);

  const user = await User.create({
    name: input.name,
    email,
    passwordHash,
    mobile: input.mobile || undefined,
    role: isAdmin ? "admin" : "user",
    provider: "local",
  });

  await queueEmail(user.email, "welcome", { name: user.name });

  return { user: toSafeUser(user), tokenVersion: user.tokenVersion ?? 0 };
}

export async function loginUser(
  input: LoginInput
): Promise<{ user: SafeUser; tokenVersion: number }> {
  await connectDB();
  const email = normaliseEmail(input.email);
  const user = await User.findOne({ email }).select("+passwordHash");

  if (!user) throw new ApiError(401, "Invalid email or password");
  if (!user.passwordHash) {
    throw new ApiError(401, "This account uses Google sign-in. Continue with Google instead.");
  }

  const valid = await verifyPassword(input.password, user.passwordHash);
  if (!valid) throw new ApiError(401, "Invalid email or password");

  user.lastLoginAt = new Date();
  await user.save();

  await queueEmail(user.email, "login-alert", { name: user.name });

  return { user: toSafeUser(user), tokenVersion: user.tokenVersion ?? 0 };
}

export async function createPasswordReset(emailInput: string): Promise<void> {
  await connectDB();
  const email = normaliseEmail(emailInput);
  const user = await User.findOne({ email });
  if (!user) return; // Do not reveal whether the address exists.

  const token = randomBytes(32).toString("hex");
  await PasswordResetToken.deleteMany({ userId: user._id });
  await PasswordResetToken.create({
    userId: user._id,
    tokenHash: hashToken(token),
    expiresAt: new Date(Date.now() + 60 * 60 * 1000),
  });

  await queueEmail(user.email, "password-reset", {
    name: user.name,
    url: `${env.appUrl}/reset-password?token=${token}`,
  });
}

export async function resetPassword(token: string, newPassword: string): Promise<void> {
  await connectDB();
  const record = await PasswordResetToken.findOne({
    tokenHash: hashToken(token),
    usedAt: { $exists: false },
    expiresAt: { $gt: new Date() },
  });

  if (!record) throw new ApiError(400, "This reset link is invalid or has expired");

  const user = await User.findById(record.userId);
  if (!user) throw new ApiError(400, "This reset link is invalid or has expired");

  user.passwordHash = await hashPassword(newPassword);
  user.tokenVersion = (user.tokenVersion ?? 0) + 1;
  await user.save();

  record.usedAt = new Date();
  await record.save();
  await PasswordResetToken.deleteMany({ userId: user._id, _id: { $ne: record._id } });

  await queueEmail(user.email, "password-changed", { name: user.name });
}

export async function updateProfile(
  userId: string,
  input: UpdateProfileInput
): Promise<{ user: SafeUser; tokenVersion: number }> {
  await connectDB();
  const user = await User.findById(userId).select("+passwordHash");
  if (!user) throw new ApiError(404, "Account not found");

  if (input.name !== undefined) user.name = input.name;
  if (input.mobile !== undefined) user.mobile = input.mobile || undefined;

  let passwordChanged = false;
  if (input.newPassword) {
    if (!input.currentPassword) throw new ApiError(400, "Current password is required");
    if (!user.passwordHash || !(await verifyPassword(input.currentPassword, user.passwordHash))) {
      throw new ApiError(400, "Current password is incorrect");
    }
    user.passwordHash = await hashPassword(input.newPassword);
    user.tokenVersion = (user.tokenVersion ?? 0) + 1;
    passwordChanged = true;
  }

  await user.save();

  if (passwordChanged) {
    await queueEmail(user.email, "password-changed", { name: user.name });
  }

  return { user: toSafeUser(user), tokenVersion: user.tokenVersion ?? 0 };
}

export type GoogleProfile = {
  sub: string;
  email: string;
  name?: string;
  picture?: string;
  email_verified?: boolean;
};

export async function loginWithGoogle(
  profile: GoogleProfile
): Promise<{ user: SafeUser; tokenVersion: number }> {
  await connectDB();
  if (!profile.email) throw new ApiError(400, "Google account has no email address");

  const email = normaliseEmail(profile.email);
  let user = await User.findOne({ $or: [{ googleId: profile.sub }, { email }] });

  if (!user) {
    user = await User.create({
      name: profile.name?.trim() || email.split("@")[0],
      email,
      googleId: profile.sub,
      provider: "google",
      avatarUrl: profile.picture,
      role: env.adminEmails.includes(email) ? "admin" : "user",
    });
    await queueEmail(user.email, "welcome", { name: user.name });
  } else {
    if (!user.googleId) user.googleId = profile.sub;
    if (!user.avatarUrl && profile.picture) user.avatarUrl = profile.picture;
    user.lastLoginAt = new Date();
    await user.save();
    await queueEmail(user.email, "login-alert", { name: user.name });
  }

  return { user: toSafeUser(user), tokenVersion: user.tokenVersion ?? 0 };
}
</file>

<file path="src/services/cartService.ts">
import { isValidObjectId } from "mongoose";
import { connectDB } from "@/lib/db";
import { ApiError } from "@/lib/apiError";
import { computeSummary } from "@/lib/money";
import { Book } from "@/models/Book";
import { Cart } from "@/models/Cart";

export type CartItemView = {
  bookId: string;
  title: string;
  author: string;
  coverImage?: string;
  price: number;
  originalPrice?: number;
  stock: number;
  quantity: number;
  lineTotal: number;
};

type LeanBook = {
  _id: unknown;
  title: string;
  authors?: Array<{ name?: string }>;
  coverImage?: string | null;
  price?: number | null;
  originalPrice?: number | null;
  stock?: number | null;
};

const MAX_QUANTITY = 10;

export async function getCart(userId: string) {
  await connectDB();
  const cart = await Cart.findOne({ userId }).lean();
  const rawItems = cart?.items ?? [];
  const books = await Book.find({ _id: { $in: rawItems.map((item) => item.bookId) } })
    .select("title authors coverImage price originalPrice stock")
    .lean();
  const bookMap = new Map(
    (books as unknown as LeanBook[]).map((book) => [String(book._id), book])
  );

  const items: CartItemView[] = rawItems.flatMap((item) => {
    const book = bookMap.get(String(item.bookId));
    if (!book || !book.price) return [];
    const stock = book.stock ?? 0;
    return [
      {
        bookId: String(book._id),
        title: book.title,
        author: book.authors?.[0]?.name ?? "Unknown author",
        coverImage: book.coverImage ?? undefined,
        price: book.price,
        originalPrice: book.originalPrice ?? undefined,
        stock,
        quantity: item.quantity,
        lineTotal: book.price * item.quantity,
      },
    ];
  });

  return { items, summary: computeSummary(items) };
}

export async function addToCart(userId: string, bookId: string, quantity: number) {
  if (!isValidObjectId(bookId)) throw new ApiError(400, "Invalid book id");
  await connectDB();
  const book = await Book.findById(bookId).select("price stock title").lean();
  if (!book) throw new ApiError(404, "Book not found");
  if (!book.price) throw new ApiError(409, "This title is not available for purchase yet");
  if ((book.stock ?? 0) <= 0) throw new ApiError(409, "This title is out of stock");

  const cart = (await Cart.findOne({ userId })) ?? new Cart({ userId, items: [] });
  const existing = cart.items.find((item) => String(item.bookId) === bookId);
  const nextQuantity = (existing?.quantity ?? 0) + quantity;

  if (nextQuantity > (book.stock ?? 0)) {
    throw new ApiError(409, `Only ${book.stock} copies are available`);
  }
  if (nextQuantity > MAX_QUANTITY) {
    throw new ApiError(400, `You can order up to ${MAX_QUANTITY} copies of a title`);
  }

  if (existing) existing.quantity = nextQuantity;
  else cart.items.push({ bookId, quantity } as never);

  await cart.save();
  return getCart(userId);
}

export async function updateCartItem(userId: string, bookId: string, quantity: number) {
  if (!isValidObjectId(bookId)) throw new ApiError(400, "Invalid book id");
  await connectDB();
  const cart = await Cart.findOne({ userId });
  if (!cart) throw new ApiError(404, "Your cart is empty");

  const item = cart.items.find((entry) => String(entry.bookId) === bookId);
  if (!item) throw new ApiError(404, "This title is not in your cart");

  const book = await Book.findById(bookId).select("stock").lean();
  if (!book) throw new ApiError(404, "Book not found");
  if (quantity > (book.stock ?? 0)) {
    throw new ApiError(409, `Only ${book.stock} copies are available`);
  }

  item.quantity = quantity;
  await cart.save();
  return getCart(userId);
}

export async function removeCartItem(userId: string, bookId: string) {
  if (!isValidObjectId(bookId)) throw new ApiError(400, "Invalid book id");
  await connectDB();
  await Cart.updateOne({ userId }, { $pull: { items: { bookId } } });
  return getCart(userId);
}

export async function mergeCart(
  userId: string,
  items: Array<{ bookId: string; quantity: number }>
) {
  await connectDB();
  if (items.length === 0) return getCart(userId);

  const validIds = items.map((item) => item.bookId).filter(isValidObjectId);
  const books = await Book.find({ _id: { $in: validIds } })
    .select("price stock")
    .lean();
  const stockMap = new Map(
    (books as unknown as LeanBook[]).map((book) => [String(book._id), book])
  );

  const cart = (await Cart.findOne({ userId })) ?? new Cart({ userId, items: [] });

  for (const incoming of items) {
    const book = stockMap.get(incoming.bookId);
    if (!book || !book.price || (book.stock ?? 0) <= 0) continue;

    const existing = cart.items.find((item) => String(item.bookId) === incoming.bookId);
    const merged = Math.min(
      (existing?.quantity ?? 0) + incoming.quantity,
      book.stock ?? 0,
      MAX_QUANTITY
    );
    if (existing) existing.quantity = merged;
    else cart.items.push({ bookId: incoming.bookId, quantity: merged } as never);
  }

  await cart.save();
  return getCart(userId);
}

export async function clearCart(userId: string) {
  await connectDB();
  await Cart.updateOne({ userId }, { $set: { items: [] } });
}
</file>

<file path="src/services/orderService.ts">
import { randomBytes } from "node:crypto";
import { isValidObjectId } from "mongoose";
import { connectDB } from "@/lib/db";
import { ApiError } from "@/lib/apiError";
import { computeSummary } from "@/lib/money";
import { queueEmail } from "@/lib/mailer";
import { Book } from "@/models/Book";
import { Order, ORDER_STATUSES } from "@/models/Order";
import { User } from "@/models/User";
import { getAddressForUser } from "@/services/addressService";
import { clearCart, getCart } from "@/services/cartService";
import type { z } from "zod";
import type { createOrderSchema } from "@/validators/order";

type CreateOrderInput = z.infer<typeof createOrderSchema>;

type BookStock = {
  _id: unknown;
  title: string;
  stock?: number | null;
  price?: number | null;
  originalPrice?: number | null;
};

function makeOrderNumber(): string {
  const date = new Date().toISOString().slice(0, 10).replaceAll("-", "");
  return `BK-${date}-${randomBytes(3).toString("hex").toUpperCase()}`;
}

async function restoreStock(items: Array<{ bookId: unknown; quantity: number }>) {
  await Promise.all(
    items.map((item) =>
      Book.updateOne({ _id: item.bookId }, { $inc: { stock: item.quantity } })
    )
  );
}

export async function createOrder(userId: string, input: CreateOrderInput) {
  await connectDB();
  const cart = await getCart(userId);
  if (cart.items.length === 0) throw new ApiError(400, "Your cart is empty");

  const address = input.addressId
    ? await getAddressForUser(userId, input.addressId)
    : input.address;

  if (!address) throw new ApiError(400, "Choose a delivery address");

  const customer = input.customer ?? {
    fullName: address.fullName,
    mobile: address.mobile,
  };

  const bookIds = cart.items.map((item) => item.bookId);
  const books = (await Book.find({ _id: { $in: bookIds } })
    .select("title stock price originalPrice")
    .lean()) as unknown as BookStock[];
  const bookMap = new Map(books.map((book) => [String(book._id), book]));

  const decremented: Array<{ bookId: string; quantity: number }> = [];

  try {
    for (const item of cart.items) {
      const book = bookMap.get(item.bookId);
      if (!book || !book.price) throw new ApiError(409, `${item.title} is no longer available`);

      const updated = await Book.findOneAndUpdate(
        { _id: book._id, stock: { $gte: item.quantity }, price: { $gt: 0 } },
        { $inc: { stock: -item.quantity } },
        { returnDocument: "after" }
      );
      if (!updated) {
        throw new ApiError(409, `${item.title} does not have enough stock`);
      }
      decremented.push({ bookId: item.bookId, quantity: item.quantity });
    }

    const summary = computeSummary(
      cart.items.map((item) => ({ price: item.price, quantity: item.quantity }))
    );

    const order = await Order.create({
      userId,
      orderNumber: makeOrderNumber(),
      items: cart.items.map((item) => ({
        bookId: item.bookId,
        title: item.title,
        author: item.author,
        coverImage: item.coverImage,
        price: item.price,
        originalPrice: bookMap.get(item.bookId)?.originalPrice ?? undefined,
        quantity: item.quantity,
      })),
      customer,
      shippingAddress: {
        label: address.label ?? "home",
        fullName: address.fullName,
        mobile: address.mobile,
        line1: address.line1,
        line2: address.line2 ?? undefined,
        city: address.city,
        state: address.state,
        pincode: address.pincode,
      },
      subtotal: summary.subtotal,
      shippingFee: summary.shippingFee,
      total: summary.total,
      paymentMethod: "cod",
      status: "placed",
      statusHistory: [{ status: "placed", at: new Date() }],
    });

    await clearCart(userId);

    const user = await User.findById(userId).select("name email").lean();
    if (user) {
      await queueEmail(user.email, "order-confirmation", {
        name: user.name,
        orderNumber: order.orderNumber,
        total: order.total,
        items: order.items.map((item) => ({
          title: item.title,
          quantity: item.quantity,
          price: item.price,
        })),
      });
    }

    return order.toObject();
  } catch (error) {
    if (decremented.length > 0) await restoreStock(decremented);
    throw error;
  }
}

export async function listOrders(userId: string) {
  await connectDB();
  return Order.find({ userId }).sort({ createdAt: -1 }).lean();
}

export async function getOrder(userId: string, orderId: string, isAdmin = false) {
  if (!isValidObjectId(orderId)) throw new ApiError(400, "Invalid order id");
  await connectDB();
  const filter = isAdmin ? { _id: orderId } : { _id: orderId, userId };
  const order = await Order.findOne(filter).lean();
  if (!order) throw new ApiError(404, "Order not found");
  return order;
}

export async function listAllOrders(options: {
  page: number;
  limit: number;
  status?: string;
  search?: string;
}) {
  await connectDB();
  const filter: Record<string, unknown> = {};
  if (options.status && ORDER_STATUSES.includes(options.status as never)) {
    filter.status = options.status;
  }
  if (options.search) {
    filter.orderNumber = new RegExp(options.search.replace(/[.*+?^${}()|[\]\\]/g, "\\$&"), "i");
  }

  const [data, total] = await Promise.all([
    Order.find(filter)
      .populate("userId", "name email")
      .sort({ createdAt: -1 })
      .skip((options.page - 1) * options.limit)
      .limit(options.limit)
      .lean(),
    Order.countDocuments(filter),
  ]);

  return {
    data,
    pagination: {
      page: options.page,
      limit: options.limit,
      total,
      totalPages: Math.ceil(total / options.limit),
    },
  };
}

export async function updateOrderStatus(
  orderId: string,
  status: (typeof ORDER_STATUSES)[number]
) {
  if (!isValidObjectId(orderId)) throw new ApiError(400, "Invalid order id");
  await connectDB();
  const order = await Order.findById(orderId);
  if (!order) throw new ApiError(404, "Order not found");

  if (order.status === status) return order.toObject();
  if (order.status === "cancelled" && status !== "cancelled") {
    throw new ApiError(409, "A cancelled order cannot be reopened");
  }

  if (status === "cancelled" && order.status !== "cancelled") {
    await restoreStock(order.items.map((item) => ({ bookId: item.bookId, quantity: item.quantity })));
  }

  order.status = status;
  order.statusHistory.push({ status, at: new Date() } as never);
  await order.save();
  return order.toObject();
}

export async function getAdminStats() {
  await connectDB();
  const [bookCount, userCount, orderCount, revenue, lowStock, pending, recentOrders] =
    await Promise.all([
      Book.countDocuments(),
      User.countDocuments({ role: "user" }),
      Order.countDocuments(),
      Order.aggregate<{ total: number }>([
        { $match: { status: { $ne: "cancelled" } } },
        { $group: { _id: null, total: { $sum: "$total" } } },
      ]),
      Book.countDocuments({ stock: { $lte: 3 } }),
      Order.countDocuments({ status: { $in: ["placed", "confirmed"] } }),
      Order.find().sort({ createdAt: -1 }).limit(6).lean(),
    ]);

  return {
    books: bookCount,
    customers: userCount,
    orders: orderCount,
    revenue: revenue[0]?.total ?? 0,
    lowStock,
    pending,
    recentOrders,
  };
}

export async function updateUserRole(
  actorId: string,
  userId: string,
  role: "user" | "admin"
) {
  await connectDB();
  if (!isValidObjectId(userId)) throw new ApiError(400, "Invalid customer id");
  if (actorId === userId) {
    throw new ApiError(400, "You cannot change your own role.");
  }

  const target = await User.findById(userId).select("role").lean();
  if (!target) throw new ApiError(404, "Customer not found");

  if (target.role === "admin" && role === "user") {
    const adminCount = await User.countDocuments({ role: "admin" });
    if (adminCount <= 1) {
      throw new ApiError(409, "At least one admin must remain.");
    }
  }

  // Bumping tokenVersion signs the affected user out everywhere so the new
  // role takes effect immediately instead of when their current JWT expires.
  const updated = await User.findByIdAndUpdate(
    userId,
    { $set: { role }, $inc: { tokenVersion: 1 } },
    { new: true }
  )
    .select("name email mobile role provider createdAt lastLoginAt")
    .lean();

  return updated;
}

export async function listUsers(options: { page: number; limit: number; search?: string }) {
  await connectDB();
  const filter: Record<string, unknown> = {};
  if (options.search) {
    const pattern = new RegExp(options.search.replace(/[.*+?^${}()|[\]\\]/g, "\\$&"), "i");
    filter.$or = [{ name: pattern }, { email: pattern }];
  }

  const [data, total] = await Promise.all([
    User.find(filter)
      .select("name email mobile role provider createdAt lastLoginAt")
      .sort({ createdAt: -1 })
      .skip((options.page - 1) * options.limit)
      .limit(options.limit)
      .lean(),
    User.countDocuments(filter),
  ]);

  return {
    data,
    pagination: { page: options.page, limit: options.limit, total, totalPages: Math.ceil(total / options.limit) },
  };
}
</file>

