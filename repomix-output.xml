}

.profile-password-note {
  font-size: 11px;
  color: var(--text-soft);
}

.profile-form .ant-form-item {
  margin-bottom: 0;
}

.profile-form .ant-form-item-label {
  padding: 0 0 6px;
}

.profile-form .ant-form-item-label > label {
