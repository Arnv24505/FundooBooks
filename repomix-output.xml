<file path="src/components/catalog/CatalogClient.tsx">
"use client";

import { useEffect, useMemo, useRef, useState } from "react";
import { useRouter, useSearchParams } from "next/navigation";
import { Button, Empty, Select, Skeleton } from "antd";
import { LeftOutlined, RightOutlined } from "@ant-design/icons";
import { useQueryClient } from "@tanstack/react-query";
import BookCard from "@/components/books/BookCard";
import QuickViewModal from "@/components/books/QuickViewModal";
import NotifyMeModal from "@/components/books/NotifyMeModal";
import { fetchBooksPage, useBooks } from "@/hooks/queries";
import type { CatalogFilters } from "@/hooks/queries";
import type { Book } from "@/types";

const PAGE_SIZE = 12;

const SORT_LABELS: Record<string, string> = {
  popular: "Popularity",
  price_asc: "Price : Low to High ",
  price_desc: "Price : High to Low ",
  newest: "Newest Arrivals",
  rating: "Top rated",
};

type PageItem = number | "ellipsis";

function paginationItems(current: number, total: number): PageItem[] {
  if (total <= 9) {
    return Array.from({ length: total }, (_, index) => index + 1);
  }
  if (current <= 5) {
    return [1, 2, 3, 4, 5, 6, 7, "ellipsis", total];
  }
  if (current >= total - 4) {
    const start = total - 6;
    return [1, "ellipsis", ...Array.from({ length: 7 }, (_, index) => start + index)];
  }
  return [
    1,
    "ellipsis",
    current - 2,
    current - 1,
    current,
    current + 1,
    current + 2,
    "ellipsis",
    total,
  ];
}

export default function CatalogClient() {
  const router = useRouter();
  const searchParams = useSearchParams();
  const queryClient = useQueryClient();
  const searchKey = searchParams.toString();

  const filters: CatalogFilters = useMemo(() => {
    const params = new URLSearchParams(searchKey);
    return {
      search: params.get("search") || undefined,
      category: params.get("category") || undefined,
      sort: params.get("sort") || "popular",
    };
  }, [searchKey]);

  const requestedPage = Number(searchParams.get("page"));
  const page = Number.isFinite(requestedPage) && requestedPage > 0 ? Math.floor(requestedPage) : 1;

  const query = useBooks(filters, page, PAGE_SIZE);

  const books = query.data?.data ?? [];
  const pagination = query.data?.pagination;
  const totalPages = pagination?.totalPages ?? 1;

  const [quickView, setQuickView] = useState<Book | null>(null);
  const [notifyBook, setNotifyBook] = useState<Book | null>(null);

  const sentinelRef = useRef<HTMLDivElement | null>(null);

  // Prefetch the next page when the sentinel comes into view so numbered page
  // jumps feel instant without streaming the whole catalogue into the DOM.
  useEffect(() => {
    const node = sentinelRef.current;
    if (!node || !pagination?.hasNextPage) return;
    const nextPage = page + 1;
    const observer = new IntersectionObserver(
      (entries) => {
        if (!entries[0]?.isIntersecting) return;
        void queryClient.prefetchQuery({
          queryKey: ["books", filters, nextPage, PAGE_SIZE],
          queryFn: () => fetchBooksPage(filters, nextPage, PAGE_SIZE),
          staleTime: 60_000,
        });
      },
      { rootMargin: "400px 0px" }
    );
    observer.observe(node);
    return () => observer.disconnect();
  }, [filters, page, pagination?.hasNextPage, queryClient]);

  function navigate(params: URLSearchParams, scrollToTop = false) {
    const queryString = params.toString();
    router.replace(queryString ? `/?${queryString}` : "/", { scroll: false });
    if (scrollToTop) window.scrollTo({ top: 0, behavior: "smooth" });
  }

  function updateSort(sort: string | undefined) {
    const next = new URLSearchParams(searchKey);
    next.delete("page");
    if (!sort || sort === "popular") next.delete("sort");
    else next.set("sort", sort);
    navigate(next);
  }

  function goToPage(nextPage: number) {
    if (nextPage < 1 || nextPage > totalPages || nextPage === page) return;
    const next = new URLSearchParams(searchKey);
    if (nextPage <= 1) next.delete("page");
    else next.set("page", String(nextPage));
    navigate(next, true);
  }

  function clearFilters() {
    navigate(new URLSearchParams());
  }

  const pageItems = paginationItems(page, totalPages);

  return (
    <>
      <div className="container-page catalog-page">
        <div className="catalog-heading">
          <div>
            <h1 className="catalog-title">
              {filters.search ? `Results for “${filters.search}”` : filters.category ? filters.category : "Popular books"}
            </h1>
            <p className="catalog-subtitle">
              {pagination ? `Showing ${(page - 1) * PAGE_SIZE + 1}–${Math.min(page * PAGE_SIZE, pagination.total)} of ${pagination.total} books` : "Discover your next read"}
            </p>
          </div>

          <div className="catalog-tools">
            <Select
              className="sort-select"
              variant="borderless"
              value={filters.sort}
              onChange={updateSort}
              options={Object.entries(SORT_LABELS).map(([value, label]) => ({ value, label }))}
              aria-label="Sort books"
            />
          </div>
        </div>

        {query.isLoading ? (
          <div className="catalog-grid">
            {Array.from({ length: 12 }).map((_, index) => (
              <div key={index} className="book-card book-card-skeleton">
                <Skeleton.Image active className="skeleton-cover" />
                <Skeleton active paragraph={{ rows: 3 }} title={false} />
              </div>
            ))}
          </div>
        ) : books.length === 0 ? (
          <div className="empty-state">
            <Empty
              description={
                filters.search
                  ? `No books match “${filters.search}”. Try a different search.`
                  : "No books found."
              }
            />
            <Button onClick={clearFilters} style={{ marginTop: 12 }}>
              Clear search
            </Button>
          </div>
        ) : (
          <>
            <div className="catalog-grid">
              {books.map((book, index) => (
                <BookCard
                  key={book._id}
                  book={book}
                  priority={index < PAGE_SIZE}
                  onQuickView={setQuickView}
                />
              ))}
            </div>

            <div ref={sentinelRef} aria-hidden />

            {totalPages > 1 ? (
              <nav className="pagination" aria-label="Catalogue pages">
                <button
                  type="button"
                  className="page-btn prev"
                  aria-label="Previous page"
                  disabled={page <= 1}
                  onClick={() => goToPage(page - 1)}
                >
                  <LeftOutlined />
                </button>

                {pageItems.map((item, index) =>
                  item === "ellipsis" ? (
                    <span className="page-ellipsis" key={`gap-${index}`}>
                      ...
                    </span>
                  ) : (
                    <button
                      type="button"
                      key={item}
                      className={`page-btn ${item === page ? "active" : ""}`}
                      aria-current={item === page ? "page" : undefined}
                      onClick={() => goToPage(item)}
                    >
                      {item}
                    </button>
                  )
                )}

                <button
                  type="button"
                  className="page-btn next"
                  aria-label="Next page"
                  disabled={page >= totalPages}
                  onClick={() => goToPage(page + 1)}
                >
                  <RightOutlined />
                </button>
              </nav>
            ) : null}
          </>
        )}
      </div>

      <QuickViewModal book={quickView} open={Boolean(quickView)} onClose={() => setQuickView(null)} />
      <NotifyMeModal book={notifyBook} open={Boolean(notifyBook)} onClose={() => setNotifyBook(null)} />
    </>
  );
}
</file>

<file path="src/components/checkout/AddressFormModal.tsx">
"use client";

import { useEffect, useState } from "react";
import { App, Button, Form, Input, Modal, Select, Switch } from "antd";
import { useQueryClient } from "@tanstack/react-query";
import { api, getApiErrorMessage, getFieldErrors } from "@/lib/apiClient";
import type { Address, ApiEnvelope } from "@/types";

type AddressFormValues = {
  label: "home" | "work" | "other";
  fullName: string;
  mobile: string;
  line1: string;
  line2?: string;
  city: string;
  state: string;
  pincode: string;
  isDefault?: boolean;
};

export default function AddressFormModal({
  open,
  onClose,
  address,
  prefill,
  onSaved,
}: {
  open: boolean;
  onClose: () => void;
  address?: Address | null;
  prefill?: { line2?: string };
  onSaved?: (address: Address) => void;
}) {
  const [form] = Form.useForm<AddressFormValues>();
  const [saving, setSaving] = useState(false);
  const { message } = App.useApp();
  const queryClient = useQueryClient();

  useEffect(() => {
    if (!open) return;
    form.resetFields();
    if (address) {
      form.setFieldsValue({
        label: address.label,
        fullName: address.fullName,
        mobile: address.mobile,
        line1: address.line1,
        line2: address.line2,
        city: address.city,
        state: address.state,
        pincode: address.pincode,
        isDefault: Boolean(address.isDefault),
      });
    } else {
      form.setFieldsValue({ label: "home", isDefault: false, ...prefill });
    }
  }, [open, address, prefill, form]);

  async function onFinish(values: AddressFormValues) {
    setSaving(true);
    try {
      const { data } = address
        ? await api.patch<ApiEnvelope<Address>>(`/addresses/${address._id}`, values)
        : await api.post<ApiEnvelope<Address>>("/addresses", values);
      await queryClient.invalidateQueries({ queryKey: ["addresses"] });
      message.success(address ? "Address updated" : "Address saved");
      onSaved?.(data.data);
      onClose();
    } catch (error) {
      const fields = getFieldErrors(error);
      if (Object.keys(fields).length > 0) {
        form.setFields(
          Object.entries(fields).map(([name, msg]) => ({
            name: name as keyof AddressFormValues,
            errors: [msg],
          }))
        );
      }
      message.error(getApiErrorMessage(error));
    } finally {
      setSaving(false);
    }
  }

  return (
    <Modal
      open={open}
      onCancel={onClose}
      footer={null}
      title={address ? "Edit address" : "Add new address"}
      width={620}
      destroyOnHidden
    >
      <Form form={form} layout="vertical" onFinish={onFinish} requiredMark={false}>
        <Form.Item name="label" label="Type" rules={[{ required: true }]}>
          <Select
            options={[
              { value: "home", label: "Home" },
              { value: "work", label: "Work" },
              { value: "other", label: "Other" },
            ]}
          />
        </Form.Item>

        <div className="address-grid">
          <Form.Item
            name="fullName"
            label="Full name"
            rules={[{ required: true, message: "Enter the recipient's name" }]}
          >
            <Input placeholder="Full name" autoComplete="name" />
          </Form.Item>
          <Form.Item
            name="mobile"
            label="Mobile number"
            rules={[
              { required: true, message: "Enter a mobile number" },
              { pattern: /^\d{10,15}$/, message: "Enter a valid mobile number" },
            ]}
          >
            <Input placeholder="10-digit mobile number" inputMode="numeric" autoComplete="tel" />
          </Form.Item>
        </div>

        <Form.Item
          name="line1"
          label="Address"
          rules={[
            { required: true, message: "Enter the address" },
            { min: 5, message: "Enter a fuller address" },
          ]}
        >
          <Input.TextArea
            rows={2}
            maxLength={200}
            placeholder="Flat / house no., building, street, area"
            autoComplete="address-line1"
          />
        </Form.Item>
        <Form.Item name="line2" label="Landmark (optional)">
          <Input placeholder="Nearby landmark" maxLength={200} autoComplete="address-line2" />
        </Form.Item>

        <div className="address-grid">
          <Form.Item
            name="city"
            label="City / town"
            rules={[{ required: true, message: "Enter the city" }]}
          >
            <Input placeholder="Bengaluru" autoComplete="address-level2" />
          </Form.Item>
          <Form.Item
            name="state"
            label="State"
            rules={[{ required: true, message: "Enter the state" }]}
          >
            <Input placeholder="Karnataka" autoComplete="address-level1" />
          </Form.Item>
        </div>

        <div className="address-grid">
          <Form.Item
            name="pincode"
            label="Pincode"
            rules={[
              { required: true, message: "Enter the pincode" },
              { pattern: /^\d{6}$/, message: "Enter a valid 6-digit pincode" },
            ]}
          >
            <Input placeholder="560034" inputMode="numeric" maxLength={6} autoComplete="postal-code" />
          </Form.Item>
          <Form.Item name="isDefault" label="Make default" valuePropName="checked">
            <Switch />
          </Form.Item>
        </div>

        <div style={{ display: "flex", gap: 10, justifyContent: "flex-end" }}>
          <Button onClick={onClose}>Cancel</Button>
          <Button type="primary" htmlType="submit" loading={saving}>
            {address ? "Save address" : "Add address"}
          </Button>
        </div>
      </Form>
    </Modal>
  );
}
</file>

<file path="src/components/checkout/CartClient.tsx">
"use client";

import { useEffect, useState } from "react";
import Link from "next/link";
import { useRouter, useSearchParams } from "next/navigation";
import { App, Button, Dropdown, Empty, Popconfirm, Skeleton } from "antd";
import type { MenuProps } from "antd";
import {
  DeleteOutlined,
  DownOutlined,
  EditOutlined,
  EnvironmentOutlined,
  PlusOutlined,
  ShoppingOutlined,
  UpOutlined,
} from "@ant-design/icons";
import { useQueryClient } from "@tanstack/react-query";
import AddressFormModal from "@/components/checkout/AddressFormModal";
import BookCover from "@/components/books/BookCover";
import { api, getApiErrorMessage } from "@/lib/apiClient";
import { formatINR } from "@/lib/money";
import { useAddresses } from "@/hooks/queries";
import { useCart } from "@/hooks/useCart";
import { useAppSelector } from "@/store/hooks";
import type { Address, ApiEnvelope, Order } from "@/types";

type Step = "cart" | "address" | "summary";

function titleCase(value: string) {
  return value.charAt(0).toUpperCase() + value.slice(1);
}

export default function CartClient() {
  const router = useRouter();
  const searchParams = useSearchParams();
  const queryClient = useQueryClient();
  const { message } = App.useApp();
  const user = useAppSelector((state) => state.auth.user);
  const ready = useAppSelector((state) => state.auth.ready);
  const { cart, isLoading, update, remove } = useCart();
  const addresses = useAddresses();

  const rawStep = searchParams.get("step");
  const step: Step = rawStep === "summary" ? "summary" : rawStep === "address" ? "address" : "cart";
  const addressExpanded = step === "address" || step === "summary";
  const summaryExpanded = step === "summary";

  const [pickedAddressId, setPickedAddressId] = useState<string | null>(null);
  const [addressOpen, setAddressOpen] = useState(false);
  const [editingAddress, setEditingAddress] = useState<Address | null>(null);
  const [addressDraft, setAddressDraft] = useState<{ line2?: string } | null>(null);
  const [placing, setPlacing] = useState(false);

  const addressList = addresses.data ?? [];
  const selectedAddress =
    addressList.find((entry) => entry._id === pickedAddressId) ??
    addressList.find((entry) => entry.isDefault) ??
    addressList[0] ??
    null;
  const selectedAddressId = selectedAddress?._id ?? null;

  useEffect(() => {
    if (ready && !user && step !== "cart") {
      router.replace(`/login?next=${encodeURIComponent(`/cart?step=${step}`)}`);
    }
  }, [ready, user, step, router]);

  function goTo(nextStep: Step) {
    if (nextStep !== "cart" && !user) {
      router.push(`/login?next=${encodeURIComponent(`/cart?step=${nextStep}`)}`);
      return;
    }
    router.push(`/cart?step=${nextStep}`, { scroll: false });
  }

  function openNewAddress(draft?: { line2?: string }) {
    setEditingAddress(null);
    setAddressDraft(draft ?? null);
    setAddressOpen(true);
  }

  function captureCurrentLocation() {
    if (typeof navigator === "undefined" || !navigator.geolocation) {
      message.info("Location is not available in this browser. Add your address instead.");
      openNewAddress();
      return;
    }
    navigator.geolocation.getCurrentPosition(
      (position) => {
        const { latitude, longitude } = position.coords;
        openNewAddress({ line2: `GPS ${latitude.toFixed(5)}, ${longitude.toFixed(5)}` });
        message.success("Current location captured — add your street details to save it.");
      },
      () => {
        message.info("Location permission was denied. Add your address instead.");
        openNewAddress();
      },
      { timeout: 8000 }
    );
  }

  const locationItems: MenuProps["items"] = [
    ...addressList.map((address) => ({
      key: address._id,
      label: (
        <span>
          <strong style={{ textTransform: "uppercase", fontSize: 11, letterSpacing: 0.6 }}>
            {address.label}
          </strong>{" "}
          {address.line1}
        </span>
      ),
    })),
    ...(addressList.length ? [{ type: "divider" as const }] : []),
    { key: "add", label: "Add New Address", icon: <PlusOutlined /> },
    { key: "current", label: "Use current location", icon: <EnvironmentOutlined /> },
  ];

  function onLocationMenuClick({ key }: { key: string }) {
    if (key === "add") {
      openNewAddress();
      return;
    }
    if (key === "current") {
      captureCurrentLocation();
      return;
    }
    setPickedAddressId(key);
  }

  async function placeOrder() {
    if (!selectedAddressId) {
      message.warning("Choose a delivery address");
      goTo("address");
      return;
    }
    setPlacing(true);
    try {
      const { data } = await api.post<ApiEnvelope<Order>>("/orders", {
        addressId: selectedAddressId,
        paymentMethod: "cod",
      });
      await Promise.all([
        queryClient.invalidateQueries({ queryKey: ["cart"] }),
        queryClient.invalidateQueries({ queryKey: ["orders"] }),
      ]);
      message.success("Order placed successfully");
      router.push(`/orders/success?id=${data.data._id}`);
    } catch (error) {
      message.error(getApiErrorMessage(error));
    } finally {
      setPlacing(false);
    }
  }

  async function deleteAddress(address: Address) {
    try {
      await api.delete(`/addresses/${address._id}`);
      await queryClient.invalidateQueries({ queryKey: ["addresses"] });
      message.success("Address removed");
    } catch (error) {
      message.error(getApiErrorMessage(error));
    }
  }

  if (!ready || isLoading) {
    return (
      <div className="container-page" style={{ padding: "30px 24px 56px" }}>
        <Skeleton active paragraph={{ rows: 6 }} />
      </div>
    );
  }

  const empty = cart.items.length === 0;

  return (
    <>
      <div className="breadcrumb-bar">
        <div className="container-page breadcrumb-inner">
          <Link href="/">Home</Link>
          <span className="breadcrumb-sep">/</span>
          <span className="breadcrumb-current">My cart</span>
        </div>
      </div>

      <div className="container-page">
        <div className="checkout-column">
          {empty ? (
            <div className="checkout-box">
              <div className="empty-state">
                <Empty description="Your bag is empty. Add a few classics to get started." />
                <Button type="primary" href="/" icon={<ShoppingOutlined />} style={{ marginTop: 16 }}>
                  Browse the catalogue
                </Button>
              </div>
            </div>
          ) : (
            <>
              <section className="checkout-box" aria-labelledby="my-cart-heading">
                <div className="checkout-head">
                  <h1 id="my-cart-heading" className="checkout-title">
                    My cart ({cart.summary.itemCount})
                  </h1>

                  <Dropdown
                    menu={{ items: locationItems, onClick: onLocationMenuClick }}
                    trigger={["click"]}
                    placement="bottomRight"
                  >
                    <button type="button" className="checkout-location">
                      <EnvironmentOutlined />
                      <span className="checkout-location-text">
                        {selectedAddress ? selectedAddress.line1 : "Use current location"}
                      </span>
                      <DownOutlined className="checkout-location-caret" />
                    </button>
                  </Dropdown>
                </div>

                <div className="checkout-cart-lines">
                  {cart.items.map((item) => (
                    <div className="checkout-cart-line" key={item.bookId}>
                      <BookCover
                        src={item.coverImage}
                        title={item.title}
                        className="checkout-cart-thumb"
                      />
                      <div className="checkout-cart-info">
                        <Link href={`/books/${item.bookId}`}>
                          <h2 className="checkout-cart-title">{item.title}</h2>
                        </Link>
                        <p className="checkout-cart-author">by {item.author}</p>
                        <div className="checkout-cart-price">
                          <span className="price-now">{formatINR(item.price)}</span>
                          {item.originalPrice && item.originalPrice > item.price ? (
                            <span className="price-was">{formatINR(item.originalPrice)}</span>
                          ) : null}
                        </div>

                        <div className="checkout-cart-controls">
                          <div className="qty-stepper" aria-label={`Quantity of ${item.title}`}>
                            <button
                              type="button"
                              aria-label="Decrease quantity"
                              onClick={() => update(item.bookId, Math.max(1, item.quantity - 1))}
                            >
                              −
                            </button>
                            <span>{item.quantity}</span>
                            <button
                              type="button"
                              aria-label="Increase quantity"
                              disabled={item.quantity >= Math.min(item.stock || 1, 10)}
                              onClick={() =>
                                update(item.bookId, Math.min(item.quantity + 1, item.stock || 1, 10))
                              }
                            >
                              +
                            </button>
                          </div>

                          <Popconfirm
                            title="Remove this title?"
                            description="You can always add it back from the catalogue."
                            okText="Remove"
                            cancelText="Keep"
                            onConfirm={() => remove(item.bookId)}
                          >
                            <button type="button" className="checkout-remove">
                              Remove
                            </button>
                          </Popconfirm>
                        </div>
                      </div>
                    </div>
                  ))}
                </div>

                <div className="checkout-actions">
                  <Button
                    type="primary"
                    className="btn-xd-blue"
                    size="large"
                    onClick={() => goTo("address")}
                  >
                    Continue
                  </Button>
                </div>
              </section>

              <section className="checkout-box" aria-labelledby="address-details-heading">
                <button
                  type="button"
                  className="checkout-head checkout-head-button"
                  onClick={() => goTo("address")}
                  aria-expanded={addressExpanded}
                  aria-controls="address-details-body"
                >
                  <h2 id="address-details-heading" className="checkout-section-title">
                    Address Details
                  </h2>
                  {addressExpanded ? <UpOutlined /> : <DownOutlined />}
                </button>

                {addressExpanded ? (
                  <div className="checkout-section-body" id="address-details-body">
                    <div className="checkout-subhead">
                      <h3>Customer Details</h3>
                      <Button icon={<PlusOutlined />} onClick={() => openNewAddress()}>
                        Add New Address
                      </Button>
                    </div>

                    {addresses.isLoading ? (
                      <Skeleton active paragraph={{ rows: 3 }} />
                    ) : selectedAddress ? (
                      <div className="customer-details">
                        <div className="customer-field">
                          <span>Full Name</span>
                          <strong>{selectedAddress.fullName}</strong>
                        </div>
                        <div className="customer-field">
                          <span>Mobile number</span>
                          <strong>{selectedAddress.mobile}</strong>
                        </div>
                        <div className="customer-field wide">
                          <span>Address</span>
                          <strong>
                            {selectedAddress.line1}
                            {selectedAddress.line2 ? `, ${selectedAddress.line2}` : ""}
                          </strong>
                        </div>
                        <div className="customer-field">
                          <span>City / town</span>
                          <strong>{selectedAddress.city}</strong>
                        </div>
                        <div className="customer-field">
                          <span>State</span>
                          <strong>{selectedAddress.state}</strong>
                        </div>
                        <div className="customer-field">
                          <span>Type</span>
                          <strong>{titleCase(selectedAddress.label)}</strong>
                        </div>
                      </div>
                    ) : (
                      <p className="checkout-hint">Add a delivery address to continue.</p>
                    )}

                    {addressList.length > 0 ? (
                      <div className="checkout-address-list">
                        {addressList.map((address) => (
                          <div
                            key={address._id}
                            className={`checkout-address-row ${
                              selectedAddressId === address._id ? "selected" : ""
                            }`}
                          >
                            <button
                              type="button"
                              className="checkout-address-select"
                              onClick={() => setPickedAddressId(address._id)}
                              aria-pressed={selectedAddressId === address._id}
                            >
                              <span className="address-label">
                                {titleCase(address.label)}
                                {address.isDefault ? " · Default" : ""}
                              </span>
                              <strong>{address.fullName}</strong>
                              <span className="checkout-address-text">
                                {address.line1}
                                {address.line2 ? `, ${address.line2}` : ""}, {address.city},{" "}
                                {address.state} {address.pincode}
                              </span>
                            </button>
                            <div className="checkout-address-actions">
                              <Button
                                type="link"
                                size="small"
                                icon={<EditOutlined />}
                                onClick={() => {
                                  setEditingAddress(address);
                                  setAddressOpen(true);
                                }}
                              >
                                Edit
                              </Button>
                              <Popconfirm
                                title="Delete this address?"
                                okText="Delete"
                                okButtonProps={{ danger: true }}
                                onConfirm={() => void deleteAddress(address)}
                              >
                                <Button type="link" danger size="small" icon={<DeleteOutlined />}>
                                  Delete
                                </Button>
                              </Popconfirm>
                            </div>
                          </div>
                        ))}
                      </div>
                    ) : null}

                    <div className="checkout-actions">
                      <Button
                        type="primary"
                        className="btn-xd-blue"
                        size="large"
                        disabled={!selectedAddressId}
                        onClick={() => goTo("summary")}
                      >
                        Continue
                      </Button>
                    </div>
                  </div>
                ) : null}
              </section>

              <section className="checkout-box" aria-labelledby="order-summary-heading">
                <button
                  type="button"
                  className="checkout-head checkout-head-button"
                  onClick={() => goTo(summaryExpanded ? "address" : "summary")}
                  aria-expanded={summaryExpanded}
                  aria-controls="order-summary-body"
                >
                  <h2 id="order-summary-heading" className="checkout-section-title">
                    Order summary
                  </h2>
                  {summaryExpanded ? <UpOutlined /> : <DownOutlined />}
                </button>

                {summaryExpanded ? (
                  <div className="checkout-section-body" id="order-summary-body">
                    <div className="checkout-summary-lines">
                      {cart.items.map((item) => (
                        <div className="checkout-summary-line" key={item.bookId}>
                          <BookCover
                            src={item.coverImage}
                            title={item.title}
                            className="checkout-cart-thumb"
                          />
                          <div className="checkout-cart-info">
                            <span className="checkout-cart-title">{item.title}</span>
                            <p className="checkout-cart-author">by {item.author}</p>
                            <div className="checkout-cart-price">
                              <span className="price-now">{formatINR(item.price)}</span>
                              {item.originalPrice && item.originalPrice > item.price ? (
                                <span className="price-was">{formatINR(item.originalPrice)}</span>
                              ) : null}
                            </div>
                          </div>
                          <span className="checkout-summary-qty">× {item.quantity}</span>
                        </div>
                      ))}
                    </div>

                    <div className="checkout-totals">
                      <div className="summary-row">
                        <span>Items ({cart.summary.itemCount})</span>
                        <span>{formatINR(cart.summary.subtotal)}</span>
                      </div>
                      <div className="summary-row">
                        <span>Delivery</span>
                        <span>
                          {cart.summary.shippingFee === 0
                            ? "Free"
                            : formatINR(cart.summary.shippingFee)}
                        </span>
                      </div>
                      <div className="summary-row total">
                        <span>Total</span>
                        <span>{formatINR(cart.summary.total)}</span>
                      </div>
                    </div>

                    <div className="checkout-actions">
                      <Popconfirm
                        title="Place order?"
                        description={`Pay ${formatINR(cart.summary.total)} on delivery.`}
                        okText="Place order"
                        cancelText="Cancel"
                        onConfirm={() => void placeOrder()}
                      >
                        <Button
                          type="primary"
                          className="btn-xd-blue"
                          size="large"
                          loading={placing}
                        >
                          Checkout
                        </Button>
                      </Popconfirm>
                    </div>
                  </div>
                ) : null}
              </section>
            </>
          )}
        </div>
      </div>

      <AddressFormModal
        open={addressOpen}
        onClose={() => setAddressOpen(false)}
        address={editingAddress}
        prefill={addressDraft ?? undefined}
        onSaved={(saved) => setPickedAddressId(saved._id)}
      />
    </>
  );
}
</file>

