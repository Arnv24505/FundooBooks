  font-size: 11px;
  line-height: 15px;
  color: var(--text-soft);
  margin-bottom: 4px;
}

.profile-address-box {
  border: 1px solid var(--line);
  border-radius: 2px;
  background: #fafafa;
  padding: 8px 10px;
  min-height: 42px;
  font-size: 12px;
  line-height: 18px;
  color: var(--text);
}

.profile-address-textarea {
  border-radius: 2px !important;
  font-size: 12px;
}

.profile-address-line2 {
  margin-top: 8px;
  height: 34px;
  font-size: 12px;
}

.profile-address-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 14px;
  padding: 14px 16px 0;
}

.profile-address-input {
  height: 36px;
  font-size: 12px;
}

.profile-address-value {
  border: 1px solid var(--line);
  border-radius: 2px;
  background: #fafafa;
  padding: 8px 10px;
  min-height: 36px;
  font-size: 12px;
  line-height: 18px;
  color: var(--text);
}

.profile-address-type {
  padding: 16px 16px 0;
}

