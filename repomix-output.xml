<file path="src/app/providers.tsx">
"use client";

import { useEffect, useState } from "react";
import { AntdRegistry } from "@ant-design/nextjs-registry";
import { App, ConfigProvider, theme } from "antd";
import { QueryClient, QueryClientProvider } from "@tanstack/react-query";
import { Provider } from "react-redux";
import { api } from "@/lib/apiClient";
import { makeStore, readStoredGuestCart } from "@/store";
import { useAppDispatch } from "@/store/hooks";
import { clearGuestCart, hydrateGuestCart, setReady, setUser } from "@/store/actions";
import type { ApiEnvelope, SafeUser } from "@/types";
import { mergeGuestCartAfterLogin } from "@/hooks/useCart";

function AuthBootstrap() {
  const dispatch = useAppDispatch();

  useEffect(() => {
    dispatch(hydrateGuestCart(readStoredGuestCart()));

    let cancelled = false;
    (async () => {
      try {
        const { data } = await api.get<ApiEnvelope<SafeUser | null>>("/auth/me");
        if (cancelled) return;
        dispatch(setUser(data.data));
        if (data.data) {
          const guestItems = readStoredGuestCart();
          if (guestItems.length > 0) {
            await mergeGuestCartAfterLogin(guestItems);
            dispatch(clearGuestCart());
          }
        }
      } catch {
        if (!cancelled) dispatch(setUser(null));
      } finally {
        if (!cancelled) dispatch(setReady(true));
      }
    })();

    return () => {
      cancelled = true;
    };
  }, [dispatch]);

  return null;
}

export default function Providers({ children }: { children: React.ReactNode }) {
  const [store] = useState(makeStore);
  const [queryClient] = useState(
    () =>
      new QueryClient({
        defaultOptions: {
          queries: {
            staleTime: 30_000,
            retry: 1,
            refetchOnWindowFocus: false,
          },
        },
      })
  );
  const dark = false;

  return (
    <AntdRegistry>
      <ConfigProvider
        theme={{
          algorithm: dark ? theme.darkAlgorithm : theme.defaultAlgorithm,
          token: {
            colorPrimary: dark ? "#d46b72" : "#a03037",
            colorLink: dark ? "#d46b72" : "#a03037",
            colorSuccess: dark ? "#5fbf76" : "#388e3c",
            colorText: dark ? "#e8e3e3" : "#333232",
            colorTextSecondary: dark ? "#b8adad" : "#878787",
            colorBgBase: dark ? "#161314" : "#ffffff",
            colorBgContainer: dark ? "#211d1e" : "#ffffff",
            colorBgElevated: dark ? "#2a2526" : "#ffffff",
            colorBorder: dark ? "#3a3334" : "#e2e2e2",
            colorBorderSecondary: dark ? "#312b2c" : "#f0f0f0",
            borderRadius: 8,
            fontFamily:
              'Roboto, Lato, "Segoe UI", -apple-system, BlinkMacSystemFont, Arial, sans-serif',
            controlHeight: 42,
          },
          components: {
            Button: { fontWeight: 600, primaryShadow: "none" },
            Input: {
              activeBorderColor: dark ? "#d46b72" : "#a03037",
              hoverBorderColor: dark ? "#bf5c63" : "#8f2b2f",
            },
            Menu: {
              itemSelectedColor: dark ? "#f0c9cc" : "#a03037",
              itemSelectedBg: dark ? "#3a2326" : "#ffe7e9",
            },
            Table: { headerBg: dark ? "#241f20" : "#f5f5f5" },
            Tabs: {
              inkBarColor: dark ? "#d46b72" : "#a03037",
              itemSelectedColor: dark ? "#d46b72" : "#a03037",
            },
          },
        }}
      >
        <Provider store={store}>
          <QueryClientProvider client={queryClient}>
            <App>
              <AuthBootstrap />
              {children}
            </App>
          </QueryClientProvider>
        </Provider>
      </ConfigProvider>
    </AntdRegistry>
  );
}
</file>

<file path="src/components/admin/AdminBookFormModal.tsx">
"use client";

import { useEffect } from "react";
import { App, Button, Form, Input, InputNumber, Modal } from "antd";
import { getApiErrorMessage, getFieldErrors } from "@/lib/apiClient";
import { useCreateAdminBook, useUpdateAdminBook } from "@/hooks/admin";
import type { AdminBookPayload } from "@/hooks/admin";
import type { Book } from "@/types";

type BookFormValues = {
  title: string;
  authors: string;
  subjects?: string;
  languages?: string;
  price: number;
  originalPrice?: number | null;
  stock: number;
  publisher?: string;
  binding?: string;
  isbn?: string;
  coverImage?: string;
  description?: string;
};

function splitList(value: string | undefined): string[] {
  return (value ?? "")
    .split(",")
    .map((entry) => entry.trim())
    .filter(Boolean);
}

export default function AdminBookFormModal({
  open,
  book,
  onClose,
}: {
  open: boolean;
  book?: Book | null;
  onClose: () => void;
}) {
  const [form] = Form.useForm<BookFormValues>();
  const { message } = App.useApp();
  const createBook = useCreateAdminBook();
  const updateBook = useUpdateAdminBook();
  const saving = createBook.isPending || updateBook.isPending;

  useEffect(() => {
    if (!open) return;
    form.resetFields();
    if (book) {
      form.setFieldsValue({
        title: book.title,
        authors: book.authors.map((author) => author.name).join(", "),
        subjects: book.subjects.join(", "),
        languages: (book.languages.length ? book.languages : ["en"]).join(", "),
        price: book.price,
        originalPrice: book.originalPrice ?? null,
        stock: book.stock ?? 0,
        publisher: book.publisher,
        binding: book.binding,
        isbn: book.isbn,
        coverImage: book.coverImage,
        description: book.description,
      });
    } else {
      form.setFieldsValue({ languages: "en", stock: 0, price: 199 });
    }
  }, [open, book, form]);

  async function onFinish(values: BookFormValues) {
    const authors = splitList(values.authors);
    if (authors.length === 0) {
      form.setFields([{ name: "authors", errors: ["Add at least one author"] }]);
      return;
    }

    const payload: AdminBookPayload = {
      title: values.title.trim(),
      authors: authors.map((name) => ({ name })),
      subjects: splitList(values.subjects),
      languages: splitList(values.languages).length ? splitList(values.languages) : ["en"],
      price: Number(values.price),
      originalPrice: values.originalPrice ? Number(values.originalPrice) : undefined,
      stock: Number(values.stock ?? 0),
      publisher: values.publisher?.trim() || undefined,
      binding: values.binding?.trim() || undefined,
      isbn: values.isbn?.trim() || undefined,
      coverImage: values.coverImage?.trim() || undefined,
      description: values.description?.trim() || undefined,
    };

    try {
      if (book) {
        await updateBook.mutateAsync({ id: book._id, payload });
        message.success("Book updated");
      } else {
        await createBook.mutateAsync(payload);
        message.success("Book added to the catalogue");
      }
      onClose();
    } catch (error) {
      const fields = getFieldErrors(error);
      if (Object.keys(fields).length > 0) {
        form.setFields(
          Object.entries(fields).map(([name, msg]) => ({
            name: name as keyof BookFormValues,
            errors: [msg],
          }))
        );
      }
      message.error(getApiErrorMessage(error));
    }
  }

  return (
    <Modal
      open={open}
      onCancel={onClose}
      footer={null}
      width={720}
      destroyOnHidden
      title={book ? "Edit book" : "Add book"}
    >
      <Form form={form} layout="vertical" onFinish={onFinish} requiredMark={false}>
        <Form.Item
          name="title"
          label="Title"
          rules={[{ required: true, message: "Enter the book title" }]}
        >
          <Input placeholder="e.g. Pride and Prejudice" maxLength={300} />
        </Form.Item>

        <div className="address-grid">
          <Form.Item
            name="authors"
            label="Authors (comma separated)"
            rules={[{ required: true, message: "Add at least one author" }]}
          >
            <Input placeholder="Jane Austen" />
          </Form.Item>
          <Form.Item name="subjects" label="Subjects / categories (comma separated)">
            <Input placeholder="Fiction, Romance" />
          </Form.Item>
        </div>

        <div className="address-grid">
          <Form.Item
            name="price"
            label="Selling price (₹)"
            rules={[{ required: true, message: "Enter the price" }]}
          >
            <InputNumber min={0} max={1_000_000} precision={0} style={{ width: "100%" }} />
          </Form.Item>
          <Form.Item name="originalPrice" label="List price (₹, optional)">
            <InputNumber min={0} max={1_000_000} precision={0} style={{ width: "100%" }} />
          </Form.Item>
        </div>

        <div className="address-grid">
          <Form.Item
            name="stock"
            label="Stock on hand"
            rules={[{ required: true, message: "Enter the stock count" }]}
          >
            <InputNumber min={0} max={100_000} precision={0} style={{ width: "100%" }} />
          </Form.Item>
          <Form.Item name="languages" label="Languages (comma separated)">
            <Input placeholder="en" />
          </Form.Item>
        </div>

        <div className="address-grid">
          <Form.Item name="publisher" label="Publisher">
            <Input placeholder="Project Gutenberg" maxLength={120} />
          </Form.Item>
          <Form.Item name="binding" label="Binding">
            <Input placeholder="Paperback" maxLength={40} />
          </Form.Item>
        </div>

        <div className="address-grid">
          <Form.Item name="isbn" label="ISBN">
            <Input placeholder="9780000000000" maxLength={20} />
          </Form.Item>
          <Form.Item
            name="coverImage"
            label="Cover image URL"
            rules={[{ type: "url", message: "Enter a valid URL" }]}
          >
            <Input placeholder="https://www.gutenberg.org/..." />
          </Form.Item>
        </div>

        <Form.Item name="description" label="Description">
          <Input.TextArea rows={4} maxLength={5000} showCount />
        </Form.Item>

        <div style={{ display: "flex", gap: 10, justifyContent: "flex-end" }}>
          <Button onClick={onClose}>Cancel</Button>
          <Button type="primary" htmlType="submit" loading={saving}>
            {book ? "Save changes" : "Add book"}
          </Button>
        </div>
      </Form>
    </Modal>
  );
}
</file>

