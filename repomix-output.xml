<file path="src/components/auth/LoginClient.tsx">
"use client";

import { useEffect, useState } from "react";
import Link from "next/link";
import { useRouter, useSearchParams } from "next/navigation";
import { Alert, App, Button, Form, Input } from "antd";
import { GoogleOutlined, LockOutlined, MailOutlined } from "@ant-design/icons";
import { useQueryClient } from "@tanstack/react-query";
import AuthShell from "@/components/auth/AuthShell";
import { api, getApiErrorMessage, getFieldErrors } from "@/lib/apiClient";
import { mergeGuestCartAfterLogin } from "@/hooks/useCart";
import { readStoredGuestCart } from "@/store";
import { useAppDispatch, useAppSelector } from "@/store/hooks";
import { clearGuestCart, setUser } from "@/store/actions";
import type { ApiEnvelope, SafeUser } from "@/types";

type LoginValues = { email: string; password: string };

function safeNext(value: string | null): string {
  if (!value || !value.startsWith("/") || value.startsWith("//")) return "/";
  return value;
}

const OAUTH_ERRORS: Record<string, string> = {
  google_not_configured:
    "Google sign-in is not configured yet. Add GOOGLE_CLIENT_ID and GOOGLE_CLIENT_SECRET to enable it.",
  google_failed: "Google sign-in could not be completed. Please try again or use Password.",
};

export default function LoginClient() {
  const router = useRouter();
  const searchParams = useSearchParams();
  const dispatch = useAppDispatch();
  const queryClient = useQueryClient();
  const { message } = App.useApp();
  const [form] = Form.useForm<LoginValues>();
  const [submitting, setSubmitting] = useState(false);
  const [formError, setFormError] = useState<string | null>(null);
  const user = useAppSelector((state) => state.auth.user);
  const ready = useAppSelector((state) => state.auth.ready);

  const next = safeNext(searchParams.get("next"));
  const oauthError = searchParams.get("error");
  const oauthMessage = oauthError ? OAUTH_ERRORS[oauthError] : null;

  useEffect(() => {
    if (ready && user) router.replace(next);
  }, [ready, user, router, next]);

  async function onFinish(values: LoginValues) {
    setSubmitting(true);
    setFormError(null);
    try {
      const { data } = await api.post<ApiEnvelope<SafeUser>>("/auth/login", values);
      dispatch(setUser(data.data));

      const guestItems = readStoredGuestCart();
      if (guestItems.length > 0) {
        try {
          await mergeGuestCartAfterLogin(guestItems);
          dispatch(clearGuestCart());
        } catch {
          // The guest cart stays in local storage and can be merged on the next sign-in.
        }
      }

      await queryClient.invalidateQueries({ queryKey: ["cart"] });
      message.success(`Welcome back, ${data.data.name.split(" ")[0]}!`);
      router.replace(next);
      router.refresh();
    } catch (error) {
      const fields = getFieldErrors(error);
      if (Object.keys(fields).length > 0) {
        form.setFields(
          Object.entries(fields).map(([name, msg]) => ({
            name: name as keyof LoginValues,
            errors: [msg],
          }))
        );
      }
      setFormError(getApiErrorMessage(error));
    } finally {
      setSubmitting(false);
    }
  }

  return (
    <AuthShell activeTab="login">
      {oauthMessage ? (
        <Alert
          type="warning"
          showIcon
          title={oauthMessage}
          style={{ marginBottom: 18 }}
        />
      ) : null}
      {formError ? (
        <Alert type="error" showIcon title={formError} style={{ marginBottom: 18 }} />
      ) : null}

      <Form form={form} layout="vertical" onFinish={onFinish} requiredMark={false} size="large">
        <Form.Item
          name="email"
          label="Email id"
          rules={[
            { required: true, message: "Enter your Email id" },
            { type: "email", message: "Enter a valid Email id" },
          ]}
        >
          <Input prefix={<MailOutlined />} placeholder="you@example.com" autoComplete="email" />
        </Form.Item>
        <Form.Item
          name="password"
          label="Password"
          rules={[{ required: true, message: "Enter Password" }]}
        >
          <Input.Password
            prefix={<LockOutlined />}
            placeholder="Password"
            autoComplete="current-password"
          />
        </Form.Item>

        <div className="auth-forgot">
          <Link href="/forgot-password">Forgot Password?</Link>
        </div>

        <Button type="primary" htmlType="submit" block size="large" loading={submitting}>
          Login
        </Button>
      </Form>

      <div className="auth-divider">OR</div>

      <div className="social-row">
        <Button
          className="social-btn Facebook"
          icon={<span className="fb-blue">f</span>}
          onClick={() => message.info("Facebook sign-in is coming soon. Please use Google or email.")}
        >
          Facebook
        </Button>
        <Button
          className="social-btn google"
          href={`/api/auth/google?next=${encodeURIComponent(next)}`}
          icon={<GoogleOutlined style={{ color: "#4285f4" }} />}
        >
          Google
        </Button>
      </div>
    </AuthShell>
  );
}
</file>

<file path="src/components/auth/ResetPasswordClient.tsx">
"use client";

import { useState } from "react";
import { useSearchParams } from "next/navigation";
import { Alert, Button, Form, Input, Result } from "antd";
import { LockOutlined } from "@ant-design/icons";
import AuthShell from "@/components/auth/AuthShell";
import { api, getApiErrorMessage } from "@/lib/apiClient";

type ResetValues = { password: string; confirm: string };

export default function ResetPasswordClient() {
  const searchParams = useSearchParams();
  const token = searchParams.get("token") ?? "";
  const [form] = Form.useForm<ResetValues>();
  const [submitting, setSubmitting] = useState(false);
  const [formError, setFormError] = useState<string | null>(null);
  const [done, setDone] = useState(false);

  async function onFinish(values: ResetValues) {
    setSubmitting(true);
    setFormError(null);
    try {
      await api.post("/auth/reset-password", { token, password: values.password });
      setDone(true);
    } catch (error) {
      setFormError(getApiErrorMessage(error));
    } finally {
      setSubmitting(false);
    }
  }

  if (!token) {
    return (
      <AuthShell
        title="Reset password"
        subtitle="This reset link is missing its token."
      >
        <Result
          status="warning"
          title="Invalid reset link"
          subTitle="Request a new link and open it from the email we send you."
          extra={
            <Button type="primary" href="/forgot-password">
              Request a new link
            </Button>
          }
        />
      </AuthShell>
    );
  }

  if (done) {
    return (
      <AuthShell title="Password updated" subtitle="You can now sign in with your new password.">
        <Result
          status="success"
          title="Password reset successful"
          subTitle="For security, all existing sessions have been signed out."
          extra={
            <Button type="primary" href="/login">
              Continue to login
            </Button>
          }
        />
      </AuthShell>
    );
  }

  return (
    <AuthShell
      title="Choose a new password"
      subtitle="Use at least 8 characters, including a letter and a number."
    >
      {formError ? (
        <Alert type="error" showIcon title={formError} style={{ marginBottom: 18 }} />
      ) : null}
      <Form form={form} layout="vertical" onFinish={onFinish} requiredMark={false} size="large">
        <Form.Item
          name="password"
          label="New password"
          rules={[
            { required: true, message: "Choose a password" },
            { min: 8, message: "Use at least 8 characters" },
            { pattern: /[A-Za-z]/, message: "Include at least one letter" },
            { pattern: /\d/, message: "Include at least one number" },
          ]}
        >
          <Input.Password
            prefix={<LockOutlined />}
            placeholder="New password"
            autoComplete="new-password"
          />
        </Form.Item>
        <Form.Item
          name="confirm"
          label="Confirm password"
          dependencies={["password"]}
          rules={[
            { required: true, message: "Confirm your new password" },
            ({ getFieldValue }) => ({
              validator(_, value) {
                if (!value || getFieldValue("password") === value) return Promise.resolve();
                return Promise.reject(new Error("Passwords do not match"));
              },
            }),
          ]}
        >
          <Input.Password
            prefix={<LockOutlined />}
            placeholder="Confirm new password"
            autoComplete="new-password"
          />
        </Form.Item>
        <Button type="primary" htmlType="submit" block size="large" loading={submitting}>
          Reset password
        </Button>
      </Form>
    </AuthShell>
  );
}
</file>

<file path="src/components/auth/SignupClient.tsx">
"use client";

import { useEffect, useState } from "react";
import { useRouter } from "next/navigation";
import { Alert, App, Button, Form, Input } from "antd";
import { LockOutlined, MailOutlined, PhoneOutlined, UserOutlined } from "@ant-design/icons";
import { useQueryClient } from "@tanstack/react-query";
import AuthShell from "@/components/auth/AuthShell";
import { api, getApiErrorMessage, getFieldErrors } from "@/lib/apiClient";
import { mergeGuestCartAfterLogin } from "@/hooks/useCart";
import { readStoredGuestCart } from "@/store";
import { useAppDispatch, useAppSelector } from "@/store/hooks";
import { clearGuestCart, setUser } from "@/store/actions";
import type { ApiEnvelope, SafeUser } from "@/types";

type SignupValues = {
  name: string;
  email: string;
  password: string;
  mobile?: string;
};

export default function SignupClient() {
  const router = useRouter();
  const dispatch = useAppDispatch();
  const queryClient = useQueryClient();
  const { message } = App.useApp();
  const [form] = Form.useForm<SignupValues>();
  const [submitting, setSubmitting] = useState(false);
  const [formError, setFormError] = useState<string | null>(null);
  const user = useAppSelector((state) => state.auth.user);
  const ready = useAppSelector((state) => state.auth.ready);

  useEffect(() => {
    if (ready && user) router.replace("/");
  }, [ready, user, router]);

  async function onFinish(values: SignupValues) {
    setSubmitting(true);
    setFormError(null);
    try {
      const { data } = await api.post<ApiEnvelope<SafeUser>>("/auth/register", {
        ...values,
        mobile: values.mobile ?? "",
      });
      dispatch(setUser(data.data));

      const guestItems = readStoredGuestCart();
      if (guestItems.length > 0) {
        try {
          await mergeGuestCartAfterLogin(guestItems);
          dispatch(clearGuestCart());
        } catch {
          // Keep the local cart for a later merge.
        }
      }

      await queryClient.invalidateQueries({ queryKey: ["cart"] });
      message.success("Your account is ready. Happy reading!");
      router.replace("/");
      router.refresh();
    } catch (error) {
      const fields = getFieldErrors(error);
      if (Object.keys(fields).length > 0) {
        form.setFields(
          Object.entries(fields).map(([name, msg]) => ({
            name: name as keyof SignupValues,
            errors: [msg],
          }))
        );
      }
      setFormError(getApiErrorMessage(error));
    } finally {
      setSubmitting(false);
    }
  }

  return (
    <AuthShell activeTab="signup">
      {formError ? (
        <Alert type="error" showIcon title={formError} style={{ marginBottom: 18 }} />
      ) : null}

      <Form form={form} layout="vertical" onFinish={onFinish} requiredMark={false} size="large">
        <Form.Item
          name="name"
          label="Full Name"
          rules={[
            { required: true, message: "Enter your Full Name" },
            { min: 2, message: "Name must be at least 2 characters" },
          ]}
        >
          <Input prefix={<UserOutlined />} placeholder="Enter Full Name" autoComplete="name" />
        </Form.Item>
        <Form.Item
          name="email"
          label="Email id"
          rules={[
            { required: true, message: "Enter your Email id" },
            { type: "email", message: "Enter a valid Email id" },
          ]}
        >
          <Input prefix={<MailOutlined />} placeholder="you@example.com" autoComplete="email" />
        </Form.Item>
        <Form.Item
          name="password"
          label="Password"
          rules={[
            { required: true, message: "Choose a password" },
            { min: 8, message: "Use at least 8 characters" },
            { pattern: /[A-Za-z]/, message: "Include at least one letter" },
            { pattern: /\d/, message: "Include at least one number" },
          ]}
        >
          <Input.Password
            prefix={<LockOutlined />}
            placeholder="At least 8 characters, with a number"
            autoComplete="new-password"
          />
        </Form.Item>
        <Form.Item
          name="mobile"
          label="Mobile number"
          rules={[
            { pattern: /^\d{10,15}$/, message: "Enter a valid Mobile number" },
          ]}
        >
          <Input
            prefix={<PhoneOutlined />}
            placeholder="10-digit Mobile number"
            autoComplete="tel"
            inputMode="numeric"
          />
        </Form.Item>

        <Button
          type="primary"
          htmlType="submit"
          block
          size="large"
          loading={submitting}
          className="auth-submit"
        >
          Signup
        </Button>
      </Form>
    </AuthShell>
  );
}
</file>

<file path="src/components/books/BookCard.tsx">
"use client";

import Link from "next/link";
import { StarFilled } from "@ant-design/icons";
import BookCover from "@/components/books/BookCover";
import { formatINR } from "@/lib/money";
import { formatAuthorName } from "@/lib/format";
import type { Book } from "@/types";

export default function BookCard({
  book,
  onQuickView,
  priority = false,
}: {
  book: Book;
  onQuickView?: (book: Book) => void;
  priority?: boolean;
}) {
  const outOfStock = (book.stock ?? 0) <= 0;
  const author = formatAuthorName(book.authors?.[0]?.name);
  const rating = Number(book.rating ?? 0);
  const reviewCount = book.reviewCount ?? 0;
  const hasStruckPrice =
    book.originalPrice !== undefined &&
    book.originalPrice !== null &&
    book.price !== undefined &&
    book.price !== null &&
    book.originalPrice > book.price;

  return (
    <article className="book-card">
      <Link href={`/books/${book._id}`} className="book-cover-wrap">
        <BookCover src={book.coverImage} title={book.title} priority={priority} />

        {onQuickView ? (
          <span
            className="quick-view"
            role="button"
            tabIndex={-1}
            onClick={(event) => {
              event.preventDefault();
              onQuickView(book);
            }}
          >
            Quick view
          </span>
        ) : null}

        {outOfStock ? <span className="out-of-stock-overlay">out of stock</span> : null}
      </Link>

      <div className="book-card-body">
        <Link href={`/books/${book._id}`}>
          <h2 className="book-card-title">{book.title}</h2>
        </Link>
        <p className="book-card-author">by {author}</p>

        <div className="book-card-rating">
          <span className="rating-badge">
            {rating.toFixed(1)}
            <StarFilled className="star" />
          </span>
          <span>({reviewCount})</span>
        </div>

        <div className="book-card-price">
          <span className="price-now">{formatINR(book.price)}</span>
          {hasStruckPrice ? (
            <span className="price-was">{formatINR(book.originalPrice)}</span>
          ) : null}
        </div>
      </div>
    </article>
  );
}
