  const [editing, setEditing] = useState<Book | null>(null);

  const query = useAdminBooks({
    page,
    limit: PAGE_SIZE,
    search: search || undefined,
    lowStock,
  });

  const books = query.data?.data ?? [];
  const pagination = query.data?.pagination;

  async function remove(book: Book) {
    try {
      await deleteBook.mutateAsync(book._id);
      message.success(`“${book.title}” deleted`);
      if (books.length === 1 && page > 1) setPage((value) => value - 1);
    } catch (error) {
      message.error(getApiErrorMessage(error));
    }
  }

  function openCreate() {
    setEditing(null);
    setFormOpen(true);
  }

  function openEdit(book: Book) {
    setEditing(book);
    setFormOpen(true);
  }

  const columns: ColumnsType<Book> = [
      {
        title: "Book",
        key: "book",
        render: (_, book) => (
          <div style={{ display: "flex", gap: 12, alignItems: "center", minWidth: 240 }}>
            <BookCover
              src={book.coverImage}
              title={book.title}
              className="admin-book-thumb"
            />
            <div style={{ minWidth: 0 }}>
              <div
                style={{
                  fontWeight: 600,
                  fontSize: 13,
                  overflow: "hidden",
                  textOverflow: "ellipsis",
                  whiteSpace: "nowrap",
                  maxWidth: 300,
                }}
                title={book.title}
              >
                {book.title}
              </div>
              <div style={{ color: "var(--text-soft)", fontSize: 12 }}>
                {book.authors.map((author) => author.name).join(", ") || "Unknown author"}
              </div>
            </div>
          </div>
        ),
      },
      {
        title: "Price",
        key: "price",
        align: "right",
        render: (_, book) => (
          <div>
            <div style={{ fontWeight: 700 }}>{formatINR(book.price)}</div>
            {book.originalPrice && book.originalPrice > (book.price ?? 0) ? (
              <div style={{ color: "var(--text-soft)", fontSize: 11, textDecoration: "line-through" }}>
                {formatINR(book.originalPrice)}
              </div>
            ) : null}
          </div>
        ),
      },
      {
        title: "Stock",
        dataIndex: "stock",
        key: "stock",
        align: "center",
        render: (stock: number | undefined) => {
          const value = stock ?? 0;
          const color = value === 0 ? "red" : value <= 3 ? "orange" : "green";
          return <Tag color={color}>{value === 0 ? "Out of stock" : `${value} left`}</Tag>;
        },
      },
      {
        title: "Rating",
        dataIndex: "rating",
        key: "rating",
        align: "center",
        render: (rating: number | undefined) => (rating ? rating.toFixed(1) : "—"),
      },
      {
        title: "Source",
        dataIndex: "isDemoData",
        key: "isDemoData",
        render: (isDemo: boolean) =>
          isDemo ? <Tag>Demo data</Tag> : <Tag color="blue">Catalogue</Tag>,
      },
      {
        title: "Actions",
        key: "actions",
        align: "right",
        render: (_, book) => (
          <div style={{ display: "flex", gap: 6, justifyContent: "flex-end" }}>
            <Button size="small" icon={<EditOutlined />} onClick={() => openEdit(book)}>
              Edit
            </Button>
            <Popconfirm
              title="Delete this book?"
              description="It will be removed from carts and wishlists too."
              okText="Delete"
              okButtonProps={{ danger: true }}
              onConfirm={() => void remove(book)}
            >
              <Button size="small" danger icon={<DeleteOutlined />} aria-label={`Delete ${book.title}`} />
            </Popconfirm>
          </div>
        ),
      },
  ];

  return (
    <>
      <div
        className="admin-section"
        style={{ display: "flex", gap: 12, alignItems: "center", flexWrap: "wrap", marginBottom: 16 }}
      >
        <Input.Search
          allowClear
          placeholder="Search title, author or ISBN"
          value={searchInput}
          onChange={(event) => setSearchInput(event.target.value)}
          onSearch={(value) => {
            setSearch(value.trim());
            setPage(1);
          }}
          style={{ maxWidth: 360, flex: "1 1 240px" }}
        />
        <div style={{ display: "flex", alignItems: "center", gap: 8 }}>
          <Switch
            checked={lowStock}
            onChange={(checked) => {
              setLowStock(checked);
              setPage(1);
            }}
          />
          <span style={{ fontSize: 13 }}>Low stock only</span>
        </div>
        <Button
          type="primary"
          icon={<PlusOutlined />}
          onClick={openCreate}
          style={{ marginLeft: "auto" }}
        >
          Add book
        </Button>
      </div>

      {query.isError ? (
        <Alert type="error" showIcon title="Could not load books. Please refresh." />
      ) : query.isLoading ? (
        <div className="admin-section">
          <Skeleton active paragraph={{ rows: 8 }} />
        </div>
      ) : (
        <div className="admin-section">
          <Table<Book>
            rowKey="_id"
            columns={columns}
            dataSource={books}
            scroll={{ x: 900 }}
            locale={{ emptyText: "No books match this view." }}
            pagination={{
              current: pagination?.page ?? page,
              pageSize: pagination?.limit ?? PAGE_SIZE,
              total: pagination?.total ?? 0,
              showSizeChanger: false,
              showTotal: (total) => `${total.toLocaleString("en-IN")} books`,
              onChange: setPage,
            }}
          />
        </div>
      )}

      <AdminBookFormModal open={formOpen} book={editing} onClose={() => setFormOpen(false)} />
    </>
  );
}
</file>

<file path="src/components/admin/AdminDashboardClient.tsx">
"use client";

import Link from "next/link";
import { Alert, Button, Skeleton, Table, Tag } from "antd";
import type { ColumnsType } from "antd/es/table";
import {
  ArrowRightOutlined,
  BookOutlined,
  ShoppingOutlined,
  TeamOutlined,
  WarningOutlined,
} from "@ant-design/icons";
import { useAdminStats } from "@/hooks/admin";
import { formatINR } from "@/lib/money";
import {
  ORDER_STATUS_COLORS,
  ORDER_STATUS_LABELS,
  formatOrderDate,
} from "@/lib/orderStatus";
import type { Order } from "@/types";

const columns: ColumnsType<Order> = [
  {
    title: "Order",
    dataIndex: "orderNumber",
    key: "orderNumber",
    render: (value: string, order) => (
      <Link href={`/admin/orders?search=${encodeURIComponent(order.orderNumber)}`}>
        <span style={{ fontWeight: 600 }}>{value}</span>
      </Link>
    ),
  },
  {
    title: "Customer",
    key: "customer",
    render: (_, order) => order.customer?.fullName ?? "—",
  },
  {
    title: "Placed",
    dataIndex: "createdAt",
    key: "createdAt",
    render: (value: string) => formatOrderDate(value),
  },
  {
    title: "Total",
    dataIndex: "total",
    key: "total",
    align: "right",
    render: (value: number) => <strong>{formatINR(value)}</strong>,
  },
  {
    title: "Status",
    dataIndex: "status",
    key: "status",
    render: (status: Order["status"]) => (
      <Tag color={ORDER_STATUS_COLORS[status]}>{ORDER_STATUS_LABELS[status]}</Tag>
    ),
  },
];

export default function AdminDashboardClient() {
  const stats = useAdminStats();
  const data = stats.data;

  if (stats.isLoading) {
    return (
      <div className="admin-section">
        <Skeleton active paragraph={{ rows: 8 }} />
      </div>
    );
  }

  if (stats.isError || !data) {
    return (
      <Alert
        type="error"
        showIcon
        title="Could not load dashboard"
        description="Please refresh the page or check that the database is reachable."
      />
    );
  }

  return (
    <>
      <div className="stat-grid">
        <div className="stat-card">
          <div className="label">Revenue (COD)</div>
          <div className="value">{formatINR(data.revenue)}</div>
          <div style={{ color: "var(--text-soft)", fontSize: 12, marginTop: 4 }}>
            Excludes cancelled orders
          </div>
        </div>
        <div className="stat-card">
          <div className="label">Orders</div>
          <div className="value">{data.orders.toLocaleString("en-IN")}</div>
          <div style={{ color: "var(--text-soft)", fontSize: 12, marginTop: 4 }}>
            {data.pending.toLocaleString("en-IN")} awaiting fulfilment
          </div>
        </div>
        <div className="stat-card">
          <div className="label">Books</div>
          <div className="value">{data.books.toLocaleString("en-IN")}</div>
          <div style={{ color: "var(--text-soft)", fontSize: 12, marginTop: 4 }}>
            {data.lowStock.toLocaleString("en-IN")} with low stock
          </div>
        </div>
        <div className="stat-card">
          <div className="label">Customers</div>
          <div className="value">{data.customers.toLocaleString("en-IN")}</div>
          <div style={{ color: "var(--text-soft)", fontSize: 12, marginTop: 4 }}>
            Registered shoppers
          </div>
        </div>
      </div>

      {data.lowStock > 0 ? (
        <Alert
          type="warning"
          showIcon
          icon={<WarningOutlined />}
          style={{ marginBottom: 16 }}
          title={`${data.lowStock.toLocaleString("en-IN")} book(s) have 3 or fewer copies left`}
          action={
            <Button size="small" href="/admin/books?lowStock=1">
              Review stock
            </Button>
          }
        />
      ) : null}

      <div className="admin-dashboard-grid">
        <section className="admin-section">
          <div
            style={{
              display: "flex",
              justifyContent: "space-between",
              alignItems: "center",
              marginBottom: 12,
            }}
          >
            <h2 style={{ fontSize: 16, margin: 0 }}>Recent orders</h2>
            <Link href="/admin/orders" style={{ color: "var(--brand)", fontSize: 13, fontWeight: 600 }}>
              View all <ArrowRightOutlined />
            </Link>
          </div>
          <Table<Order>
            rowKey="_id"
            columns={columns}
            dataSource={data.recentOrders}
            pagination={false}
            size="middle"
            scroll={{ x: 640 }}
            locale={{ emptyText: "No orders yet" }}
          />
        </section>

        <aside className="admin-section">
          <h2 style={{ fontSize: 16, margin: "0 0 14px" }}>Quick actions</h2>
          <div style={{ display: "grid", gap: 10 }}>
            <Button block icon={<BookOutlined />} href="/admin/books">
              Manage catalogue
            </Button>
            <Button block icon={<ShoppingOutlined />} href="/admin/orders">
              Fulfil orders
            </Button>
            <Button block icon={<TeamOutlined />} href="/admin/users">
              View customers
            </Button>
            <Button block type="primary" href="/">
              Open storefront
            </Button>
          </div>

          <div
            style={{
              marginTop: 20,
              padding: 14,
              borderRadius: 10,
              background: "#fafafa",
              fontSize: 13,
              lineHeight: 1.6,
              color: "#555",
            }}
          >
            <strong style={{ display: "block", color: "#2a2a2a", marginBottom: 4 }}>
              Storefront pricing
            </strong>
            Prices, stock and ratings imported from the demo catalogue are marked as demo data.
            Saving a book in the admin keeps those fields under your control.
          </div>
        </aside>
      </div>
    </>
  );
}
