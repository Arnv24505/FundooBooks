"use client";

import { configureStore } from "@reduxjs/toolkit";
import { authReducer, cartReducer } from "@/store/slices";
import type { GuestCartItem } from "@/types";

const GUEST_CART_KEY = "bookstore_guest_cart";

/**
 * Creates a fresh store for each browser session (and each server render).
 * Client state kept here is intentionally limited to auth identity and the
 * guest cart; server data lives in TanStack Query.
 */
export function makeStore() {
  const store = configureStore({
    reducer: { auth: authReducer, cart: cartReducer },
    devTools: process.env.NODE_ENV !== "production",
  });

  if (typeof window !== "undefined") {
    store.subscribe(() => {
      const { guestItems } = store.getState().cart;
      try {
        window.localStorage.setItem(GUEST_CART_KEY, JSON.stringify(guestItems));
      } catch {
        // Storage can be unavailable in private mode; the in-memory cart still works.
      }
    });
  }

  return store;
}

export type AppStore = ReturnType<typeof makeStore>;
export type RootState = ReturnType<AppStore["getState"]>;
export type AppDispatch = AppStore["dispatch"];

export function readStoredGuestCart(): GuestCartItem[] {
  if (typeof window === "undefined") return [];
  try {
    const raw = window.localStorage.getItem(GUEST_CART_KEY);
    if (!raw) return [];
    const parsed = JSON.parse(raw) as unknown;
    if (!Array.isArray(parsed)) return [];
    return parsed.filter(
      (item): item is GuestCartItem =>
        typeof item === "object" &&
        item !== null &&
        typeof (item as { bookId?: unknown }).bookId === "string" &&
        typeof (item as { quantity?: unknown }).quantity === "number"
    );
  } catch {
    return [];
  }
}
</file>

<file path="src/store/slices.ts">
import { createSlice, type PayloadAction } from "@reduxjs/toolkit";
import type { GuestCartItem } from "@/types";

type AuthState = {
  user: import("@/types").SafeUser | null;
  ready: boolean;
};

type CartState = {
  guestItems: GuestCartItem[];
  hydrated: boolean;
};

const authSlice = createSlice({
  name: "auth",
  initialState: { user: null, ready: false } as AuthState,
  reducers: {
    setUser(state, action: PayloadAction<AuthState["user"]>) {
      state.user = action.payload;
      state.ready = true;
    },
    setReady(state, action: PayloadAction<boolean>) {
      state.ready = action.payload;
    },
  },
});

const cartSlice = createSlice({
  name: "cart",
  initialState: { guestItems: [], hydrated: false } as CartState,
  reducers: {
    hydrateGuestCart(state, action: PayloadAction<GuestCartItem[]>) {
      state.guestItems = action.payload;
      state.hydrated = true;
    },
    addGuestItem(state, action: PayloadAction<GuestCartItem>) {
      const existing = state.guestItems.find((item) => item.bookId === action.payload.bookId);
      if (existing) {
        existing.quantity = Math.min(existing.quantity + action.payload.quantity, existing.stock, 10);
      } else {
        state.guestItems.push({
          ...action.payload,
          quantity: Math.min(action.payload.quantity, action.payload.stock, 10),
        });
      }
    },
    updateGuestItem(
      state,
      action: PayloadAction<{ bookId: string; quantity: number }>
    ) {
      const item = state.guestItems.find((entry) => entry.bookId === action.payload.bookId);
      if (item) item.quantity = Math.max(1, Math.min(action.payload.quantity, item.stock, 10));
    },
    removeGuestItem(state, action: PayloadAction<string>) {
      state.guestItems = state.guestItems.filter((item) => item.bookId !== action.payload);
    },
    clearGuestCart(state) {
      state.guestItems = [];
    },
  },
});

export const { setUser, setReady } = authSlice.actions;
export const {
  hydrateGuestCart,
  addGuestItem,
  updateGuestItem,
  removeGuestItem,
  clearGuestCart,
} = cartSlice.actions;

export const authReducer = authSlice.reducer;
export const cartReducer = cartSlice.reducer;
</file>

