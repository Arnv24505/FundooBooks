{
  "name": "bookstore",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "import:books": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local src/scripts/importBooks.ts",
    "refresh:books": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local src/scripts/refreshStorefrontFields.ts",
    "make:admin": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local src/scripts/makeAdmin.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "lighthouse": "node scripts/lighthouse.mjs"
  },
  "dependencies": {
    "@ant-design/icons": "^6.3.4",
    "@ant-design/nextjs-registry": "^1.3.0",
    "@ant-design/v5-patch-for-react-19": "^1.0.3",
    "@reduxjs/toolkit": "^2.14.0",
    "@tanstack/react-query": "^5.107.1",
    "antd": "^6.7.0",
    "axios": "^1.21.0",
    "bcryptjs": "^3.0.3",
    "jose": "^6.2.15",
    "mongoose": "^9.12.0",
    "next": "16.4.5",
    "nodemailer": "^10.3.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-redux": "^9.3.1",
    "winston": "^3.19.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.12",
    "chrome-launcher": "^1.2.3",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "lighthouse": "^13.6.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^4.1.12"
  }
}
