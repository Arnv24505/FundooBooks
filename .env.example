# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# MongoDB Atlas connection string. Include the database name (e.g. /Bookstore).
# MONGO_URI is the primary name; MONGODB_URI is accepted as a fallback.
MONGO_URI="mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/Bookstore?retryWrites=true&w=majority"
# MONGODB_URI=
# Optional explicit database name override.
# MONGODB_DB_NAME=Bookstore

# ---------------------------------------------------------------------------
# Authentication
# ---------------------------------------------------------------------------
# At least 32 characters. Generate with: openssl rand -base64 48
JWT_SECRET="replace-with-a-long-random-string-at-least-32-chars"
JWT_EXPIRES_IN="7d"

# Comma-separated emails that are promoted to admin on registration/login.
# ADMIN_EMAILS="owner@example.com"

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
# Public base URL, no trailing slash. Add this host to Google OAuth redirects.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# Google OAuth (optional)
# ---------------------------------------------------------------------------
# Authorised redirect URI:
#   {NEXT_PUBLIC_APP_URL}/api/auth/google/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# SMTP email (optional in development)
# ---------------------------------------------------------------------------
# When unset, transactional emails are stored in the EmailJob collection
# instead of being sent, so registration and checkout still work locally.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=you@example.com
# SMTP_PASS=your-app-password
# SMTP_FROM="Bookstore <no-reply@example.com>"
